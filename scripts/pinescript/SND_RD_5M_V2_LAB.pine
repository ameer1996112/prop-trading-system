//@version=6
indicator("SND RD 5M V2 CONTRACT LAB", overlay = true, max_bars_back = 5000, max_boxes_count = 300, max_labels_count = 300, max_lines_count = 500)

// Contract-evidence observation producer. Decisions occur on closed 5m bars.

const string DIRECTION_DEMAND = "DEMAND"
const string DIRECTION_SUPPLY = "SUPPLY"
const string FORMATION_REVERSAL = "REVERSAL"
const string FORMATION_CONTINUATION = "CONTINUATION"
const string GEOMETRY_STANDARD = "STANDARD"
const string GEOMETRY_ACCURACY = "ACCURACY"
const string STATE_FRESH = "CONFIRMED_FRESH"
const string STATE_TAPPED = "TAPPED"
const string STATE_INVALIDATED = "INVALIDATED"
const string ELIGIBILITY_WAITING = "WAITING_FOR_LIQUIDITY"
const string ELIGIBILITY_ELIGIBLE = "ELIGIBLE"
const string ELIGIBILITY_EXPIRED = "EXPIRED"
const string SETUP_WAITING = "WAITING_FOR_ELIGIBILITY"
const string SETUP_ARMED = "ARMED"
const string SETUP_SHADOW_ONLY = "SHADOW_ONLY"
const string SETUP_REJECTED = "REJECTED"
const string DISPLAY_CLEAN = "Clean"
const string DISPLAY_QUALIFIED_ONLY = "Qualified only"
const string DISPLAY_SETUPS_ONLY = "Setups only"
const string DISPLAY_RAW_AUDIT = "Raw audit"
const int APPROACH_LOOKBACK_BARS = 20
const string VALIDATION_SCHEMA = "rd-forex-validation/v1"
const int VALIDATION_MAX_PAYLOAD_CHARS = 35000
const int VALIDATION_MAX_BATCH_EVENTS = 200
const string RD_RULE_CONTRACT_VERSION = "1.0.0"
const string SETUP_EXPORT_SCHEMA = "1.2"
const string SETUP_EXPORT_STRATEGY_ID = "rd_liquidity_sd_5m_v1"
const string SETUP_EXPORT_STRATEGY_VERSION = "1.2.0-contract1"
const int SETUP_EXPORT_MAX_TRANSITIONS = 64
const int SETUP_EXPORT_MAX_SNAPSHOT_SETUPS = 256
const int SETUP_EXPORT_MAX_PAYLOAD_CHARS = 35000

const string CONFIRM_CLOSE_BEYOND_ORIGIN = "CONFIRM_CLOSE_BEYOND_ORIGIN"
const string REJECT_FORMATION_INTERRUPTED = "REJECT_FORMATION_INTERRUPTED"
const string REJECT_UNKNOWN_APPROACH = "REJECT_UNKNOWN_APPROACH"
const string TAP_POST_CONFIRM_OVERLAP = "TAP_POST_CONFIRM_OVERLAP"
const string INVALIDATE_PRE_ENTRY_CLOSE_INSIDE_OR_THROUGH = "INVALIDATE_PRE_ENTRY_CLOSE_INSIDE_OR_THROUGH"
const string WAIT_MINIMUM_LIQUIDITY_CANDLES = "WAIT_MINIMUM_LIQUIDITY_CANDLES"
const string REJECT_ONE_CANDLE_LIQUIDITY = "REJECT_ONE_CANDLE_LIQUIDITY"
const string WAIT_LIQUIDITY_OWN_EXTREME = "WAIT_LIQUIDITY_OWN_EXTREME"
const string LIQUIDITY_OWN_EXTREME_TAKEN = "LIQUIDITY_OWN_EXTREME_TAKEN"
const string WAIT_LIQUIDITY_SWEEP_AFTER_OWN_EXTREME = "WAIT_LIQUIDITY_SWEEP_AFTER_OWN_EXTREME"
const string LIQUIDITY_SEQUENCE_QUALIFIED = "LIQUIDITY_SEQUENCE_QUALIFIED"
const string EXPIRE_ZONE_NOT_FRESH = "EXPIRE_ZONE_NOT_FRESH"
const string EXPIRE_OPPOSITE_ZONE_RETRACE = "EXPIRE_OPPOSITE_ZONE_RETRACE"
const string WAIT_SETUP_ELIGIBILITY = "WAIT_SETUP_ELIGIBILITY"
const string ARM_SETUP_AFTER_LIQUIDITY = "ARM_SETUP_AFTER_LIQUIDITY"
const string WAIT_DIRECTIONAL_CLOSE_AFTER_TOUCH = "WAIT_DIRECTIONAL_CLOSE_AFTER_TOUCH"
const string SHADOW_NON_EXACT_REQUIRED_RULES = "SHADOW_NON_EXACT_REQUIRED_RULES"
const string REJECT_TARGET_TAP_WITHOUT_ELIGIBILITY = "REJECT_TARGET_TAP_WITHOUT_ELIGIBILITY"
const string REJECT_TARGET_INVALIDATED_ON_RETURN = "REJECT_TARGET_INVALIDATED_ON_RETURN"
const string SHADOW_AMBIGUOUS_SAME_BAR_ORDER = "SHADOW_AMBIGUOUS_SAME_BAR_ORDER"
const string SHADOW_AMBIGUOUS_SAME_BAR_ROUTE = "SHADOW_AMBIGUOUS_SAME_BAR_ROUTE"
const string SHADOW_LIQUIDITY_PRIMARY_REPLACED = "SHADOW_LIQUIDITY_PRIMARY_REPLACED"

maxZones = input.int(120, "Maximum zones", minval = 10, maxval = 200, group = "Display")
projectionBars = input.int(120, "Fresh-zone projection bars", minval = 1, maxval = 500, group = "Display")
displayMode = input.string(DISPLAY_CLEAN, "View", options = [DISPLAY_CLEAN, DISPLAY_QUALIFIED_ONLY, DISPLAY_SETUPS_ONLY, DISPLAY_RAW_AUDIT], group = "Display")
premiumVisuals = input.bool(true, "Premium visuals", group = "Display")
cleanZonesPerLevel = input.int(1, "Clean zones per overlapping level", minval = 1, maxval = 3, group = "Display")
setupOutcomeBars = input.int(12, "Recent setup outcome bars", minval = 1, maxval = 120, group = "Display")
showFresh = input.bool(true, "Show fresh zones", group = "Display")
showTapped = input.bool(false, "Show tapped zones", group = "Display")
showInvalidated = input.bool(false, "Show invalidated zones", group = "Display")
showLiquidityLines = input.bool(true, "Show liquidity lines", group = "Display")
showLiquidityProofLines = input.bool(false, "Show liquidity proof lines", group = "Display")
showStatusPanel = input.bool(false, "Show status panel", group = "Display")
liquidityPivotStrength = input.int(2, "Liquidity pivot strength", minval = 1, maxval = 10, group = "Liquidity")
showLabels = input.bool(false, "Show diagnostic labels", group = "Diagnostics")
emitDiagnostics = input.bool(false, "Emit non-executable diagnostic alerts", group = "Diagnostics")
exportSetupEvents = input.bool(false, "Export non-executable setup events", group = "Automation", tooltip = "Phase 1 observation only. Emits confirmed 5m setup-state batches and never places orders.")
setupExportCredential = input.string("", "Setup export credential", group = "Automation", tooltip = "Required dedicated Phase 1 ingress credential. No setup payload is emitted while empty.")
setupExportProducerTag = input.string("tradingview", "Producer tag", group = "Automation", tooltip = "Operator label used to distinguish chart-alert producers. Reloading the script creates a new producer instance.")
setupExportDetectorHash = input.string("unverified", "Detector code hash", group = "Automation", tooltip = "Version-control or artifact digest supplied by the operator.")
setupExportSettingsHash = input.string("unverified", "Settings hash", group = "Automation", tooltip = "Digest of the locked TradingView input profile supplied by the operator.")
validationCapture = input.bool(false, "Validation capture", group = "Validation")
validationRunId = input.string("manual-run", "Parent run ID", group = "Validation")
validationParentHash = input.string("unverified", "Parent manifest hash", group = "Validation")
validationCaptureId = input.string("manual-capture", "Capture ID", group = "Validation")
validationCaptureHash = input.string("unverified", "Capture manifest hash", group = "Validation")
validationCalculationStart = input.time(0, "Calculation start", group = "Validation")
validationEmissionStart = input.time(0, "Emission start", group = "Validation")
validationEmissionEnd = input.time(0, "Emission end", group = "Validation")

demandColor = input.color(color.new(color.teal, 72), "Demand", group = "Colors")
supplyColor = input.color(color.new(color.red, 76), "Supply", group = "Colors")
tappedColor = input.color(color.new(color.gray, 82), "Tapped", group = "Colors")
invalidatedColor = input.color(color.new(color.black, 88), "Invalidated", group = "Colors")
liquidityPendingColor = input.color(color.orange, "Liquidity pending", group = "Colors")
liquiditySweptColor = input.color(color.teal, "Liquidity swept", group = "Colors")
liquiditySecondaryColor = input.color(color.new(color.gray, 35), "Liquidity own extreme", group = "Colors")

string instrumentTicker = str.upper(syminfo.ticker)
bool isGoldMarket = str.contains(instrumentTicker, "XAU") or str.contains(instrumentTicker, "GOLD")
bool isIndexMarket = str.contains(instrumentTicker, "NAS") or str.contains(instrumentTicker, "US100") or str.contains(instrumentTicker, "USTEC") or str.contains(instrumentTicker, "NDX") or str.contains(instrumentTicker, "SPX") or str.contains(instrumentTicker, "US500") or str.contains(instrumentTicker, "US30") or str.contains(instrumentTicker, "DJI")

setupContractIdentifier(string value) =>
    string allowedCharacters = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_.:@|+-"
    string result = ""
    int characterCount = str.length(value)
    if characterCount > 0
        for characterIndex = 0 to characterCount - 1
            string character = str.substring(value, characterIndex, characterIndex + 1)
            result := result + (str.contains(allowedCharacters, character) ? character : "_")
    result := str.length(result) == 0 ? "unknown" : result
    str.substring(result, 0, math.min(str.length(result), 160))

setupContractDigestLabel(string value) =>
    string result = setupContractIdentifier(value)
    result := str.length(result) < 8 ? result + ".digest" : result
    str.substring(result, 0, math.min(str.length(result), 128))

var int setupExportProducerStartedAt = timenow
var string setupExportProducerTagSafe = setupContractIdentifier(setupExportProducerTag)
var string setupExportProducerInstanceId = str.substring(setupExportProducerTagSafe, 0, math.min(str.length(setupExportProducerTagSafe), 120)) + ":" + str.tostring(setupExportProducerStartedAt)
var int setupExportBatchSequence = 0
var bool setupExportSnapshotPending = true

type Candidate
    bool isActive
    bool isForming
    int originBar
    int originTime
    float originOpen
    float originHigh
    float originLow
    float originClose
    int approachDirection
    int firstDepartureBar
    float firstDepartureHigh
    float firstDepartureLow
    float distal

type LiquidityLevel
    bool demand
    float anchor
    int anchorBar
    float nearExtreme
    int nearExtremeBar
    int formedBar
    int oppositeCandleCount
    bool taken
    int takenBar
    line liquidityLine
    line ownExtremeLine

type RawZone
    int id
    bool demand
    string formation
    string geometry
    int originBar
    int originTime
    int confirmationBar
    int confirmationTime
    float originHigh
    float originLow
    float firstDepartureHigh
    float firstDepartureLow
    float formationDistal
    float top
    float bottom
    string state
    int stateBar
    int stateTime
    string reason
    bool departureActive
    string eligibilityState
    int eligibilityBar
    int eligibilityTime
    string eligibilityReason
    bool liquidityQualified
    float liquidityAnchor
    int liquidityAnchorBar
    float liquidityExtreme
    int liquidityExtremeBar
    int liquidityFormedBar
    int liquidityTakenBar
    int liquiditySweptBar
    float liquidityDistance
    float liquidityDistanceGuidanceMax
    string liquidityDistanceFidelity
    array<int> liquidityIndexes
    int liquidityPrimaryIndex
    int pendingLiquidityPrimaryIndex
    bool liquidityScanInitialized
    int routeBlockerId
    string setupState
    int setupBar
    int setupTime
    string setupReason
    string setupEntryModel
    int setupEntryConfirmedTime
    float setupLiquidityAnchor
    int setupLiquidityAnchorTime
    float setupLiquidityExtreme
    int setupLiquidityExtremeTime
    int setupLiquidityFormedTime
    int setupLiquidityTakenTime
    int setupLiquiditySweptTime
    string exportedSetupState
    array<string> setupExportFromStates
    array<string> setupExportToStates
    array<string> setupExportReasons
    box zoneBox
    line liquidityLine
    line ownExtremeLine
    label debugLabel

method reset(Candidate this) =>
    this.isActive := false
    this.isForming := false
    this.originBar := na
    this.originTime := na
    this.originOpen := na
    this.originHigh := na
    this.originLow := na
    this.originClose := na
    this.approachDirection := 0
    this.firstDepartureBar := na
    this.firstDepartureHigh := na
    this.firstDepartureLow := na
    this.distal := na

candleDirection(int offset) =>
    close[offset] > open[offset] ? 1 : close[offset] < open[offset] ? -1 : 0

previousDirectionalCandle() =>
    int result = 0
    for offset = 1 to APPROACH_LOOKBACK_BARS
        if result == 0 and not na(close[offset])
            result := candleDirection(offset)
    result

method begin(Candidate this) =>
    this.isActive := true
    this.isForming := false
    this.originBar := bar_index
    this.originTime := time
    this.originOpen := open
    this.originHigh := high
    this.originLow := low
    this.originClose := close
    this.approachDirection := previousDirectionalCandle()
    this.firstDepartureBar := na
    this.firstDepartureHigh := na
    this.firstDepartureLow := na
    this.distal := na

method rebaseInsideFormation(Candidate this, bool demand) =>
    bool rebased = false
    if this.isActive and this.isForming
        rebased := high <= this.originHigh and low >= this.originLow
        if rebased
            this.isForming := false
            this.originBar := bar_index
            this.originTime := time
            this.originOpen := open
            this.originHigh := high
            this.originLow := low
            this.originClose := close
            this.approachDirection := previousDirectionalCandle()
            this.firstDepartureBar := na
            this.firstDepartureHigh := na
            this.firstDepartureLow := na
            this.distal := demand ? low : high
    rebased

method advance(Candidate this, bool demand) =>
    if not this.isForming
        this.isForming := true
        this.firstDepartureBar := bar_index
        this.firstDepartureHigh := high
        this.firstDepartureLow := low
        this.distal := demand ? (na(this.distal) ? low : math.min(this.distal, low)) : (na(this.distal) ? high : math.max(this.distal, high))
    else
        this.distal := demand ? math.min(this.distal, low) : math.max(this.distal, high)
    demand ? close > this.originHigh : close < this.originLow

candidateFormation(Candidate candidate, bool demand) =>
    string result = ""
    if candidate.approachDirection != 0
        bool continuation = demand ? candidate.approachDirection == 1 : candidate.approachDirection == -1
        result := continuation ? FORMATION_CONTINUATION : FORMATION_REVERSAL
    result

buildConfirmedZone(Candidate candidate, bool demand, int zoneId, string formation) =>
    bool accuracyCondition = demand ? candidate.originHigh > candidate.firstDepartureHigh : candidate.originLow < candidate.firstDepartureLow
    bool accuracy = accuracyCondition
    string geometry = accuracy ? GEOMETRY_ACCURACY : GEOMETRY_STANDARD
    float bodyHigh = math.max(candidate.originOpen, candidate.originClose)
    float bodyLow = math.min(candidate.originOpen, candidate.originClose)
    float frozenTop = accuracy and demand ? bodyHigh : candidate.originHigh
    float frozenBottom = accuracy and not demand ? bodyLow : candidate.originLow
    if demand
        frozenBottom := math.min(frozenBottom, candidate.distal)
    else
        frozenTop := math.max(frozenTop, candidate.distal)

    RawZone zone = RawZone.new()
    zone.id := zoneId
    zone.demand := demand
    zone.formation := formation
    zone.geometry := geometry
    zone.originBar := candidate.originBar
    zone.originTime := candidate.originTime
    zone.confirmationBar := bar_index
    zone.confirmationTime := time_close
    zone.originHigh := candidate.originHigh
    zone.originLow := candidate.originLow
    zone.firstDepartureHigh := candidate.firstDepartureHigh
    zone.firstDepartureLow := candidate.firstDepartureLow
    zone.formationDistal := candidate.distal
    zone.top := frozenTop
    zone.bottom := frozenBottom
    zone.state := STATE_FRESH
    zone.stateBar := na
    zone.stateTime := na
    zone.reason := CONFIRM_CLOSE_BEYOND_ORIGIN
    zone.departureActive := true
    zone.eligibilityState := ELIGIBILITY_WAITING
    zone.eligibilityBar := na
    zone.eligibilityTime := na
    zone.eligibilityReason := WAIT_MINIMUM_LIQUIDITY_CANDLES
    zone.liquidityQualified := false
    zone.liquidityAnchor := na
    zone.liquidityAnchorBar := na
    zone.liquidityExtreme := na
    zone.liquidityExtremeBar := na
    zone.liquidityFormedBar := na
    zone.liquidityTakenBar := na
    zone.liquiditySweptBar := na
    zone.liquidityDistance := na
    zone.liquidityDistanceGuidanceMax := na
    zone.liquidityDistanceFidelity := "UNRESOLVED"
    zone.liquidityIndexes := array.new<int>()
    zone.liquidityPrimaryIndex := na
    zone.pendingLiquidityPrimaryIndex := na
    zone.liquidityScanInitialized := false
    zone.routeBlockerId := na
    zone.setupState := SETUP_WAITING
    zone.setupBar := na
    zone.setupTime := na
    zone.setupReason := WAIT_SETUP_ELIGIBILITY
    zone.setupEntryModel := ""
    zone.setupEntryConfirmedTime := na
    zone.setupLiquidityAnchor := na
    zone.setupLiquidityAnchorTime := na
    zone.setupLiquidityExtreme := na
    zone.setupLiquidityExtremeTime := na
    zone.setupLiquidityFormedTime := na
    zone.setupLiquidityTakenTime := na
    zone.setupLiquiditySweptTime := na
    zone.exportedSetupState := ""
    zone.setupExportFromStates := array.new<string>()
    zone.setupExportToStates := array.new<string>()
    zone.setupExportReasons := array.new<string>()
    zone.zoneBox := na
    zone.liquidityLine := na
    zone.ownExtremeLine := na
    zone.debugLabel := na
    zone

zoneDistanceFromPrice(RawZone zone) =>
    close < zone.bottom ? zone.bottom - close : close > zone.top ? close - zone.top : 0.0

zonesOverlap(RawZone first, RawZone other) =>
    first.bottom <= other.top and first.top >= other.bottom

setupIncludedInView(RawZone zone) =>
    bool armed = zone.setupState == SETUP_ARMED
    bool terminal = zone.setupState == SETUP_SHADOW_ONLY or zone.setupState == SETUP_REJECTED
    bool recentTerminal = terminal and not na(zone.setupBar) and bar_index >= zone.setupBar and bar_index - zone.setupBar <= setupOutcomeBars
    armed or recentTerminal

zoneIncludedInCuratedView(RawZone zone) =>
    displayMode == DISPLAY_SETUPS_ONLY ? setupIncludedInView(zone) : zone.state == STATE_FRESH and (displayMode != DISPLAY_QUALIFIED_ONLY or zone.liquidityQualified)

setupZoneRanksAhead(RawZone candidate, RawZone target, float candidateDistance, float targetDistance) =>
    bool ranksAhead = candidateDistance < targetDistance or (candidateDistance == targetDistance and candidate.id > target.id)
    if displayMode == DISPLAY_SETUPS_ONLY
        bool candidateArmed = candidate.setupState == SETUP_ARMED
        bool targetArmed = target.setupState == SETUP_ARMED
        if candidateArmed != targetArmed
            ranksAhead := candidateArmed
        else if not candidateArmed and candidate.setupBar != target.setupBar
            ranksAhead := candidate.setupBar > target.setupBar
    ranksAhead

zoneSelectedForCleanView(RawZone target, array<RawZone> allZones) =>
    int closerCount = 0
    float targetDistance = zoneDistanceFromPrice(target)
    int candidateCount = array.size(allZones)
    if candidateCount > 0
        for candidateIndex = 0 to candidateCount - 1
            RawZone candidate = array.get(allZones, candidateIndex)
            bool comparable = candidate.id != target.id and candidate.demand == target.demand and zoneIncludedInCuratedView(candidate) and zonesOverlap(candidate, target)
            if comparable
                float candidateDistance = zoneDistanceFromPrice(candidate)
                bool ranksAhead = setupZoneRanksAhead(candidate, target, candidateDistance, targetDistance)
                if ranksAhead
                    closerCount += 1
    closerCount < cleanZonesPerLevel

zoneVisible(RawZone zone, array<RawZone> allZones) =>
    bool lifecycleVisible = zone.state == STATE_FRESH ? showFresh : zone.state == STATE_TAPPED ? showTapped : showInvalidated
    displayMode == DISPLAY_RAW_AUDIT ? lifecycleVisible : displayMode == DISPLAY_SETUPS_ONLY ? setupIncludedInView(zone) and zoneSelectedForCleanView(zone, allZones) : showFresh and zoneIncludedInCuratedView(zone) and zoneSelectedForCleanView(zone, allZones)

zoneBaseColor(RawZone zone) =>
    color result = displayMode == DISPLAY_SETUPS_ONLY ? (zone.setupState == SETUP_ARMED ? (zone.demand ? color.teal : color.red) : zone.setupState == SETUP_SHADOW_ONLY ? color.orange : color.gray) : zone.state == STATE_TAPPED ? tappedColor : zone.state == STATE_INVALIDATED ? invalidatedColor : (zone.demand ? demandColor : supplyColor)
    result

zoneColor(RawZone zone) =>
    color baseColor = zoneBaseColor(zone)
    premiumVisuals ? color.new(baseColor, 76) : baseColor

zoneBorderColor(RawZone zone) =>
    premiumVisuals ? color.new(zoneBaseColor(zone), 28) : zone.demand ? color.teal : color.red

zoneBorderWidth(RawZone zone) =>
    displayMode == DISPLAY_SETUPS_ONLY and zone.setupState == SETUP_ARMED ? 2 : 1

zoneRightBar(RawZone zone) =>
    zone.state == STATE_FRESH ? bar_index + projectionBars : zone.stateBar

liquidityDistanceToZone(RawZone zone, LiquidityLevel level) =>
    zone.demand ? level.nearExtreme - zone.top : zone.bottom - level.nearExtreme

liquidityGuidanceMaxPips() =>
    float guidance = na
    if str.contains(instrumentTicker, "GBPJPY")
        guidance := 10.0
    else if str.contains(instrumentTicker, "EURUSD")
        guidance := 5.0
    else if str.contains(instrumentTicker, "USDJPY")
        guidance := 3.0
    guidance

liquidityPipSize() =>
    str.contains(instrumentTicker, "JPY") ? 0.01 : 0.0001

liquidityGuidanceMaxPrice() =>
    float guidancePips = liquidityGuidanceMaxPips()
    na(guidancePips) ? na : guidancePips * liquidityPipSize()

liquidityDistanceFidelity() =>
    not na(liquidityGuidanceMaxPips()) ? "CALIBRATED" : (isGoldMarket or isIndexMarket ? "DISCRETIONARY" : "UNRESOLVED")

liquiditySupportsZone(RawZone zone, LiquidityLevel level) =>
    float distance = liquidityDistanceToZone(zone, level)
    float guidanceMax = liquidityGuidanceMaxPrice()
    bool withinObservationGuidance = na(guidanceMax) or distance <= guidanceMax
    level.demand == zone.demand and distance > 0 and withinObservationGuidance

liquidityRanksCloser(RawZone zone, LiquidityLevel candidate, LiquidityLevel primary) =>
    float candidateDistance = liquidityDistanceToZone(zone, candidate)
    float primaryDistance = liquidityDistanceToZone(zone, primary)
    candidateDistance < primaryDistance - syminfo.mintick * 0.5

zoneText(RawZone zone) =>
    string side = zone.demand ? "D" : "S"
    string bounds = "oH " + str.tostring(zone.originHigh, format.mintick) + " oL " + str.tostring(zone.originLow, format.mintick) + " dH " + str.tostring(zone.firstDepartureHigh, format.mintick) + " dL " + str.tostring(zone.firstDepartureLow, format.mintick) + " env " + str.tostring(zone.formationDistal, format.mintick) + " z " + str.tostring(zone.top, format.mintick) + "/" + str.tostring(zone.bottom, format.mintick)
    "Z" + str.tostring(zone.id) + " " + side + " " + zone.formation + " " + zone.geometry + "\n" + bounds + "\n" + zone.state + " " + zone.reason + "\n" + zone.eligibilityState + " " + zone.eligibilityReason + " qualified " + str.tostring(zone.liquidityQualified) + "\n" + zone.setupState + " " + zone.setupReason

setupDisplayText(RawZone zone) =>
    displayMode == DISPLAY_SETUPS_ONLY ? (premiumVisuals ? zone.setupState : zone.setupState + "\n" + zone.setupReason) : ""

updateZoneDrawing(RawZone zone, array<RawZone> allZones) =>
    bool visible = zoneVisible(zone, allZones)
    if visible
        int rightBar = zoneRightBar(zone)
        if na(zone.zoneBox)
            zone.zoneBox := box.new(zone.originBar, zone.top, rightBar, zone.bottom, xloc = xloc.bar_index, bgcolor = zoneColor(zone), border_color = zoneBorderColor(zone), border_width = zoneBorderWidth(zone))
        else
            box.set_right(zone.zoneBox, rightBar)
            box.set_top(zone.zoneBox, zone.top)
            box.set_bottom(zone.zoneBox, zone.bottom)
            box.set_bgcolor(zone.zoneBox, zoneColor(zone))
            box.set_border_color(zone.zoneBox, zoneBorderColor(zone))
            box.set_border_width(zone.zoneBox, zoneBorderWidth(zone))
        box.set_text(zone.zoneBox, setupDisplayText(zone))
        box.set_text_color(zone.zoneBox, color.new(color.white, 5))
        box.set_text_size(zone.zoneBox, size.tiny)
        box.set_text_halign(zone.zoneBox, text.align_right)
        box.set_text_valign(zone.zoneBox, text.align_center)
        bool diagnosticLabelsVisible = not premiumVisuals and displayMode == DISPLAY_RAW_AUDIT and showLabels
        if diagnosticLabelsVisible
            if na(zone.debugLabel)
                zone.debugLabel := label.new(zone.originBar, zone.demand ? zone.bottom : zone.top, zoneText(zone), xloc = xloc.bar_index, style = zone.demand ? label.style_label_up : label.style_label_down, color = color.new(color.black, 15), textcolor = color.white, size = size.tiny)
            else
                label.set_text(zone.debugLabel, zoneText(zone))
        else if not na(zone.debugLabel)
            label.delete(zone.debugLabel)
            zone.debugLabel := na
    else
        if not na(zone.zoneBox)
            box.delete(zone.zoneBox)
            zone.zoneBox := na
        if not na(zone.debugLabel)
            label.delete(zone.debugLabel)
            zone.debugLabel := na

    bool zoneLiquidityVisible = visible and showLiquidityLines and displayMode != DISPLAY_RAW_AUDIT and (displayMode != DISPLAY_SETUPS_ONLY or zone.setupState == SETUP_ARMED) and not na(zone.liquidityPrimaryIndex) and not na(zone.liquidityAnchor) and not na(zone.liquidityAnchorBar) and not na(zone.liquidityExtreme) and not na(zone.liquidityExtremeBar)
    if zoneLiquidityVisible
        int liquidityRightBar = zoneRightBar(zone)
        int liquidityLeftBar = math.max(zone.originBar, zone.liquidityExtremeBar)
        int ownExtremeLeftBar = math.max(zone.originBar, zone.liquidityAnchorBar)
        bool liquidityTaken = not na(zone.liquiditySweptBar)
        color primaryColor = premiumVisuals ? color.new(color.gray, liquidityTaken ? 40 : 18) : liquidityTaken ? liquiditySweptColor : liquidityPendingColor
        color ownExtremeColor = premiumVisuals ? color.new(color.gray, liquidityTaken ? 45 : 12) : liquiditySecondaryColor
        string ownExtremeStyle = liquidityTaken ? line.style_solid : line.style_dashed
        if na(zone.liquidityLine)
            zone.liquidityLine := line.new(liquidityLeftBar, zone.liquidityExtreme, liquidityRightBar, zone.liquidityExtreme, xloc = xloc.bar_index, extend = extend.none, color = primaryColor, style = line.style_solid, width = 2)
        else
            line.set_xy1(zone.liquidityLine, liquidityLeftBar, zone.liquidityExtreme)
            line.set_xy2(zone.liquidityLine, liquidityRightBar, zone.liquidityExtreme)
            line.set_color(zone.liquidityLine, primaryColor)
            line.set_style(zone.liquidityLine, line.style_solid)
            line.set_width(zone.liquidityLine, 2)
        if showLiquidityProofLines
            if na(zone.ownExtremeLine)
                zone.ownExtremeLine := line.new(ownExtremeLeftBar, zone.liquidityAnchor, liquidityRightBar, zone.liquidityAnchor, xloc = xloc.bar_index, extend = extend.none, color = ownExtremeColor, style = ownExtremeStyle, width = 2)
            else
                line.set_xy1(zone.ownExtremeLine, ownExtremeLeftBar, zone.liquidityAnchor)
                line.set_xy2(zone.ownExtremeLine, liquidityRightBar, zone.liquidityAnchor)
                line.set_color(zone.ownExtremeLine, ownExtremeColor)
                line.set_style(zone.ownExtremeLine, ownExtremeStyle)
                line.set_width(zone.ownExtremeLine, 2)
        else if not na(zone.ownExtremeLine)
            line.delete(zone.ownExtremeLine)
            zone.ownExtremeLine := na
    else
        if not na(zone.liquidityLine)
            line.delete(zone.liquidityLine)
            zone.liquidityLine := na
        if not na(zone.ownExtremeLine)
            line.delete(zone.ownExtremeLine)
            zone.ownExtremeLine := na
    true

addUniqueLiquidityIndex(array<int> selectedIndexes, int candidateIndex) =>
    if not na(candidateIndex) and not array.includes(selectedIndexes, candidateIndex)
        array.push(selectedIndexes, candidateIndex)

liquidityIsPrimary(int candidateIndex, array<RawZone> allZones) =>
    bool primary = false
    int zoneCount = array.size(allZones)
    if zoneCount > 0
        for zoneIndex = 0 to zoneCount - 1
            RawZone zone = array.get(allZones, zoneIndex)
            if zoneVisible(zone, allZones) and zone.liquidityPrimaryIndex == candidateIndex
                primary := true
    primary

updateLiquidityDrawings(array<LiquidityLevel> levels, array<int> drawnIndexes, array<RawZone> allZones) =>
    array<int> selectedIndexes = array.new<int>()
    array<int> selectedZoneIndexes = array.new<int>()
    int levelCount = array.size(levels)

    int zoneCount = array.size(allZones)
    if zoneCount > 0
        for zoneIndex = 0 to zoneCount - 1
            RawZone zone = array.get(allZones, zoneIndex)
            bool lifecycleVisible = zone.state == STATE_FRESH ? showFresh : zone.state == STATE_TAPPED ? showTapped : showInvalidated
            if displayMode == DISPLAY_RAW_AUDIT and lifecycleVisible
                int linkedCount = array.size(zone.liquidityIndexes)
                if linkedCount > 0
                    for linkedOffset = 0 to linkedCount - 1
                        int candidateIndex = array.get(zone.liquidityIndexes, linkedOffset)
                        if candidateIndex < levelCount
                            LiquidityLevel candidate = array.get(levels, candidateIndex)
                            if liquiditySupportsZone(zone, candidate) and not array.includes(selectedIndexes, candidateIndex)
                                array.push(selectedIndexes, candidateIndex)
                                array.push(selectedZoneIndexes, zoneIndex)

    int previousCount = array.size(drawnIndexes)
    if previousCount > 0
        for previousOffset = 0 to previousCount - 1
            int previousIndex = array.get(drawnIndexes, previousOffset)
            if previousIndex < levelCount and not array.includes(selectedIndexes, previousIndex)
                LiquidityLevel previousLevel = array.get(levels, previousIndex)
                if not na(previousLevel.liquidityLine)
                    line.delete(previousLevel.liquidityLine)
                    previousLevel.liquidityLine := na
                if not na(previousLevel.ownExtremeLine)
                    line.delete(previousLevel.ownExtremeLine)
                    previousLevel.ownExtremeLine := na
                array.set(levels, previousIndex, previousLevel)

    int selectedCount = array.size(selectedIndexes)
    if showLiquidityLines and selectedCount > 0
        for selectedOffset = 0 to selectedCount - 1
            int candidateIndex = array.get(selectedIndexes, selectedOffset)
            if candidateIndex < levelCount
                LiquidityLevel level = array.get(levels, candidateIndex)
                RawZone ownerZone = array.get(allZones, array.get(selectedZoneIndexes, selectedOffset))
                bool primary = liquidityIsPrimary(candidateIndex, allZones)
                int rightBar = zoneRightBar(ownerZone)
                int liquidityLeftBar = math.max(ownerZone.originBar, level.nearExtremeBar)
                int ownExtremeLeftBar = math.max(ownerZone.originBar, level.anchorBar)
                color lineColor = premiumVisuals ? color.new(color.gray, level.taken ? 40 : 18) : level.taken ? liquiditySweptColor : liquidityPendingColor
                int lineWidth = primary ? 2 : 1
                if na(level.liquidityLine)
                    level.liquidityLine := line.new(liquidityLeftBar, level.nearExtreme, rightBar, level.nearExtreme, xloc = xloc.bar_index, extend = extend.none, color = lineColor, style = line.style_solid, width = lineWidth)
                else
                    line.set_xy1(level.liquidityLine, liquidityLeftBar, level.nearExtreme)
                    line.set_xy2(level.liquidityLine, rightBar, level.nearExtreme)
                    line.set_color(level.liquidityLine, lineColor)
                    line.set_style(level.liquidityLine, line.style_solid)
                    line.set_width(level.liquidityLine, lineWidth)

                color ownExtremeColor = premiumVisuals ? color.new(color.gray, level.taken ? 45 : 12) : liquiditySecondaryColor
                string ownExtremeStyle = level.taken ? line.style_solid : line.style_dashed
                if na(level.ownExtremeLine)
                    level.ownExtremeLine := line.new(ownExtremeLeftBar, level.anchor, rightBar, level.anchor, xloc = xloc.bar_index, extend = extend.none, color = ownExtremeColor, style = ownExtremeStyle, width = lineWidth)
                else
                    line.set_xy1(level.ownExtremeLine, ownExtremeLeftBar, level.anchor)
                    line.set_xy2(level.ownExtremeLine, rightBar, level.anchor)
                    line.set_color(level.ownExtremeLine, ownExtremeColor)
                    line.set_style(level.ownExtremeLine, ownExtremeStyle)
                    line.set_width(level.ownExtremeLine, lineWidth)
                array.set(levels, candidateIndex, level)

    if not showLiquidityLines and previousCount > 0
        for previousOffset = 0 to previousCount - 1
            int previousIndex = array.get(drawnIndexes, previousOffset)
            if previousIndex < levelCount
                LiquidityLevel previousLevel = array.get(levels, previousIndex)
                if not na(previousLevel.liquidityLine)
                    line.delete(previousLevel.liquidityLine)
                    previousLevel.liquidityLine := na
                if not na(previousLevel.ownExtremeLine)
                    line.delete(previousLevel.ownExtremeLine)
                    previousLevel.ownExtremeLine := na
                array.set(levels, previousIndex, previousLevel)

    array.clear(drawnIndexes)
    if showLiquidityLines and selectedCount > 0
        for selectedOffset = 0 to selectedCount - 1
            array.push(drawnIndexes, array.get(selectedIndexes, selectedOffset))
    true

diagnosticPayload(string eventName, RawZone zone) =>
    "{" +
     "\"schema_version\":\"" + VALIDATION_SCHEMA + "\"," +
     "\"event\":\"" + eventName + "\"," +
     "\"strategy_id\":\"snd_rd_5m_v1_lab\"," +
     "\"executable\":false," +
     "\"run_id\":\"" + validationRunId + "\"," +
     "\"capture_id\":\"" + validationCaptureId + "\"," +
     "\"symbol\":\"" + syminfo.tickerid + "\"," +
     "\"feed\":\"" + syminfo.prefix + "\"," +
     "\"timeframe\":\"" + timeframe.period + "\"," +
     "\"zone_id\":" + str.tostring(zone.id) + "," +
     "\"object_id\":\"" + str.tostring(zone.id) + "\"," +
     "\"model\":\"" + zone.geometry + "_" + zone.formation + "\"," +
     "\"zone_type\":\"" + (zone.demand ? "demand" : "supply") + "\"," +
     "\"direction\":\"" + (zone.demand ? "demand" : "supply") + "\"," +
     "\"formation\":\"" + zone.formation + "\"," +
     "\"geometry\":\"" + zone.geometry + "\"," +
     "\"origin_bar\":" + str.tostring(zone.originBar) + "," +
     "\"origin_time\":" + str.tostring(zone.originTime) + "," +
     "\"confirmation_bar\":" + str.tostring(zone.confirmationBar) + "," +
     "\"confirmation_time\":" + str.tostring(zone.confirmationTime) + "," +
     "\"bar_time\":" + str.tostring(time_close) + "," +
     "\"top\":" + str.tostring(zone.top, format.mintick) + "," +
     "\"bottom\":" + str.tostring(zone.bottom, format.mintick) + "," +
     "\"state\":\"" + zone.state + "\"," +
     "\"reason\":\"" + zone.reason + "\"," +
     "\"eligibility_state\":\"" + zone.eligibilityState + "\"," +
     "\"eligibility_reason\":\"" + zone.eligibilityReason + "\"," +
     "\"liquidity_qualified\":" + str.tostring(zone.liquidityQualified) + "," +
     "\"liquidity_anchor\":" + (na(zone.liquidityAnchor) ? "null" : str.tostring(zone.liquidityAnchor, format.mintick)) + "," +
     "\"liquidity_anchor_bar\":" + (na(zone.liquidityAnchorBar) ? "null" : str.tostring(zone.liquidityAnchorBar)) + "," +
     "\"liquidity_extreme\":" + (na(zone.liquidityExtreme) ? "null" : str.tostring(zone.liquidityExtreme, format.mintick)) + "," +
     "\"liquidity_extreme_bar\":" + (na(zone.liquidityExtremeBar) ? "null" : str.tostring(zone.liquidityExtremeBar)) + "," +
     "\"liquidity_taken_bar\":" + (na(zone.liquidityTakenBar) ? "null" : str.tostring(zone.liquidityTakenBar)) + "," +
     "\"liquidity_swept_bar\":" + (na(zone.liquiditySweptBar) ? "null" : str.tostring(zone.liquiditySweptBar)) + "," +
     "\"liquidity_distance\":" + (na(zone.liquidityDistance) ? "null" : str.tostring(zone.liquidityDistance, format.mintick)) + "," +
     "\"liquidity_distance_guidance_max\":" + (na(zone.liquidityDistanceGuidanceMax) ? "null" : str.tostring(zone.liquidityDistanceGuidanceMax, format.mintick)) + "," +
     "\"liquidity_distance_fidelity\":\"" + zone.liquidityDistanceFidelity + "\"," +
     "\"liquidity_primary_index\":" + (na(zone.liquidityPrimaryIndex) ? "null" : str.tostring(zone.liquidityPrimaryIndex)) + "," +
     "\"route_blocker_zone_id\":" + (na(zone.routeBlockerId) ? "null" : str.tostring(zone.routeBlockerId)) + "," +
     "\"setup_state\":\"" + zone.setupState + "\"," +
     "\"setup_reason\":\"" + zone.setupReason + "\"," +
     "\"setup_time\":" + (na(zone.setupTime) ? "null" : str.tostring(zone.setupTime)) + "}"

appendValidationEvent(string buffer, string eventPayload) =>
    str.length(buffer) == 0 ? eventPayload : buffer + "," + eventPayload

validationHeartbeat() =>
    "{" +
     "\"schema_version\":\"" + VALIDATION_SCHEMA + "\"," +
     "\"event\":\"BAR_HEARTBEAT\"," +
     "\"event_id\":\"bar:" + str.tostring(time_close) + "\"," +
     "\"bar_time\":" + str.tostring(time_close) + "," +
     "\"symbol\":\"" + syminfo.tickerid + "\"," +
     "\"feed\":\"" + syminfo.prefix + "\"," +
     "\"timeframe\":\"" + timeframe.period + "\"," +
     "\"open\":" + str.tostring(open, format.mintick) + "," +
     "\"high\":" + str.tostring(high, format.mintick) + "," +
     "\"low\":" + str.tostring(low, format.mintick) + "," +
     "\"close\":" + str.tostring(close, format.mintick) + "}"

validationFailure(string eventName, string failureReason) =>
    "{" +
     "\"schema_version\":\"" + VALIDATION_SCHEMA + "\"," +
     "\"event\":\"" + eventName + "\"," +
     "\"event_id\":\"run:" + str.tostring(time_close) + ":" + eventName + "\"," +
     "\"bar_time\":" + str.tostring(time_close) + "," +
     "\"symbol\":\"" + syminfo.tickerid + "\"," +
     "\"feed\":\"" + syminfo.prefix + "\"," +
