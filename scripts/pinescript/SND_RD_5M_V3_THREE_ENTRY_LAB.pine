    attempt.htf60.htf60AnchorEpoch := na
    attempt.htf60.htf60OpenTicks := na
    attempt.htf60.htf60ContactSeen := false
    attempt.htf60.htf60DestinationBeforeContact := false
    attempt.htf60.htf60ContactOpenEpoch := na
