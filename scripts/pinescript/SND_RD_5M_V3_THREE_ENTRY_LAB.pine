    attempt.htf15.htf15ContactLowTicks := na
    attempt.htf15.htf15ContactCloseTicks := na
    attempt.htf15.htf15ContactTickEpoch := na
    attempt.htf15.htf15ContactTickSequence := na
    attempt.htf15.htf15CoverageReady := false
    attempt.htf15.htf15PreviousAtOrInsideOpen := false
    attempt.htf15.htf15LastTickSequence := na
    attempt.htf15.htf15LastTickEpoch := na
    attempt.htf15.htf15PreviousTickTicks := na
    attempt.htf15.htf15CoverageStartEpoch := na
    attempt.htf15.htf15CoverageGapDetected := false
    attempt.htf15.htf15TriggeredThisTick := false
    attempt.htf15.htf15TriggerExact := false
    attempt.htf30.htf30AnchorEpoch := na
    attempt.htf30.htf30OpenTicks := na
    attempt.htf30.htf30ContactSeen := false
    attempt.htf30.htf30DestinationBeforeContact := false
    attempt.htf30.htf30ContactOpenEpoch := na
    attempt.htf30.htf30ContactCloseEpoch := na
