    attempt.core.entryTicks := na
    attempt.core.stopTicks := na
    attempt.core.targetTicks := na
    attempt

ensureEntryAttempt(RawZone zone) =>
    int attemptIndex = entryAttemptIndex(zone.id)
    if na(attemptIndex) and zone.state == STATE_TAPPED and zone.setupState == SETUP_ARMED
        if array.size(entryAttempts) < ENTRY_MAX_ATTEMPTS
            EntryAttempt attempt = newEntryAttempt(zone)
            array.push(entryAttempts, attempt)
            attemptIndex := array.size(entryAttempts) - 1
        else
            log.error("ENTRY_ATTEMPT_HARD_CAP_REACHED")
    attemptIndex

materializeEngagedEntryAttempts(array<RawZone> zoneItems) =>
    bool materialized = false
    int zoneCount = array.size(zoneItems)
    if zoneCount > 0
        for zoneIndex = 0 to zoneCount - 1
            RawZone zone = array.get(zoneItems, zoneIndex)
            if zone.state == STATE_TAPPED and zone.setupState == SETUP_ARMED
                int attemptIndex = ensureEntryAttempt(zone)
                materialized := materialized or not na(attemptIndex)
    materialized

commonRuleResultsPayload(EntryAttempt attempt) =>
    "[" +
     "{\"rule_id\":\"LIQ_ACTUAL_EXTREME_SWEPT\",\"passed\":" + str.tostring(attempt.core.ruleLiqActualExtremeSwept) + "}," +
     "{\"rule_id\":\"LIQ_DISTANCE_INFLUENCES_ZONE\",\"passed\":" + str.tostring(attempt.core.ruleLiqDistanceInfluencesZone) + "}," +
     "{\"rule_id\":\"LIQ_EVENT_ORDER\",\"passed\":" + str.tostring(attempt.core.ruleLiqEventOrder) + "}," +
     "{\"rule_id\":\"LIQ_INTERNAL_REBREAK\",\"passed\":" + str.tostring(attempt.core.ruleLiqInternalRebreak) + "}," +
     "{\"rule_id\":\"LIQ_NORMAL_TWO_OPPOSITE_CANDLES\",\"passed\":" + str.tostring(attempt.core.ruleLiqNormalTwoOppositeCandles) + "}," +
     "{\"rule_id\":\"LIQ_ONE_CANDLE_EXCEPTION\",\"passed\":" + str.tostring(attempt.core.ruleLiqOneCandleException) + "}," +
     "{\"rule_id\":\"LIQ_OWN_EXTREME_SAME_LEG\",\"passed\":" + str.tostring(attempt.core.ruleLiqOwnExtremeSameLeg) + "}," +
     "{\"rule_id\":\"LIQ_REPLACEMENT_AFTER_STALE_MOVE\",\"passed\":" + str.tostring(attempt.core.ruleLiqReplacementAfterStaleMove) + "}," +
     "{\"rule_id\":\"LIQ_STRICT_OWN_EXTREME_BREAK\",\"passed\":" + str.tostring(attempt.core.ruleLiqStrictOwnExtremeBreak) + "}," +
     "{\"rule_id\":\"TIMEFRAME_FIVE_MINUTE_ONLY\",\"passed\":" + str.tostring(attempt.core.ruleTimeframeFiveMinuteOnly) + "}," +
     "{\"rule_id\":\"ZONE_ACCURACY_BOUNDS\",\"passed\":" + str.tostring(attempt.core.ruleZoneAccuracyBounds) + "}," +
     "{\"rule_id\":\"ZONE_FRESH_UNTAPPED\",\"passed\":" + str.tostring(attempt.core.ruleZoneFreshUntapped) + "}," +
     "{\"rule_id\":\"ZONE_ORIGIN_OPPOSITE_CANDLE\",\"passed\":" + str.tostring(attempt.core.ruleZoneOriginOppositeCandle) + "}," +
     "{\"rule_id\":\"ZONE_PRE_ENTRY_CLOSE_OUTSIDE\",\"passed\":" + str.tostring(attempt.core.ruleZonePreEntryCloseOutside) + "}" +
     "]"

entrySourceClaims(string model, string bocTier) =>
    model == ENTRY_MODEL_BOC ? (bocTier == BOC_TIER_HTF ? "[\"discretionary-break-2025-11\",\"reject-non-htf-break-2026-05\",\"htf-timed-boc-2026-06\"]" : "[\"discretionary-break-2025-11\"]") :
     model == ENTRY_MODEL_CLOSE ? "[\"standard-close-2024-03\",\"closure-or-flip-2025-03\",\"directional-close-2025-08\",\"directional-close-required-2026-06\",\"model-continuation-2026-07\"]" :
     "[\"htf-flip-2024-03\",\"htf-context-set-2025-08\",\"htf-flip-definition-2025-08\",\"pure-flip-narrowing-2026-05\",\"model-continuation-2026-07\"]"

entryCandidateId(string model) =>
    model == ENTRY_MODEL_BOC ? "EDGE_DERIVED:BOC" :
     model == ENTRY_MODEL_CLOSE ? "EDGE_DERIVED:DIR_CLOSE" :
     "EDGE_DERIVED:HTF_FLIP"

entryEvidenceId(string model) =>
    model == ENTRY_MODEL_BOC ? "EDGE_DERIVED:BOC" :
     model == ENTRY_MODEL_CLOSE ? "EDGE_DERIVED:DIR_CLOSE" :
     "EDGE_DERIVED:HTF_FLIP"

entryPassedRules(string model, bool exact) =>
    not exact ? "[]" : model == ENTRY_MODEL_BOC ? "[\"ENTRY_BOC_HTF_TIMED\"]" : model == ENTRY_MODEL_CLOSE ? "[\"ENTRY_DIR_CLOSE\"]" : "[\"ENTRY_HTF_FLIP\"]"

entryFailedRules(EntryAttempt attempt, string model, string bocTier, bool exact, bool commonExact) =>
    exact ? "[]" :
     not commonExact ? "[\"COMMON_SETUP_NOT_EXACT\"]" :
     model == ENTRY_MODEL_BOC and bocTier == BOC_TIER_DISCRETIONARY and attempt.boc.bocFidelity == "DISCRETIONARY" ? "[\"" + BOC_DISCRETIONARY_CONTEXT_UNQUANTIFIED + "\"]" :
     model == ENTRY_MODEL_BOC ? "[\"" + attempt.boc.bocFailureCode + "\"]" :
     model == ENTRY_MODEL_FLIP ? "[\"" + attempt.flip.flipFailureCode + "\"]" :
     "[\"HISTORICAL_ORDER_UNPROVEN\"]"

entryAmbiguities(string model, bool exact) =>
    exact or model == ENTRY_MODEL_CLOSE ? "[]" : "[\"SHADOW_SAME_CHILD_BAR_ORDER\"]"

entryHtfContexts(int mask) =>
    mask == 7 ? "[15,30,60]" : mask == 6 ? "[30,60]" : mask == 5 ? "[15,60]" : mask == 4 ? "[60]" : mask == 3 ? "[15,30]" : mask == 2 ? "[30]" : mask == 1 ? "[15]" : "[]"

orderedCandlePayload(int openEpoch, int closeEpoch, int openTicks, int highTicks, int lowTicks, int closeTicks) =>
    "{\"open_epoch\":" + str.tostring(openEpoch) + ",\"close_epoch\":" + str.tostring(closeEpoch) + ",\"open_ticks\":" + str.tostring(openTicks) + ",\"high_ticks\":" + str.tostring(highTicks) + ",\"low_ticks\":" + str.tostring(lowTicks) + ",\"close_ticks\":" + str.tostring(closeTicks) + "}"

nullableEntryInt(bool present, int value) =>
    present and not na(value) ? str.tostring(value) : "null"

nullableEntryBool(bool present, bool value) =>
    present ? str.tostring(value) : "null"

nullableOrderedCandlePayload(bool present, int openEpoch, int closeEpoch, int openTicks, int highTicks, int lowTicks, int closeTicks) =>
    present ? orderedCandlePayload(openEpoch, closeEpoch, openTicks, highTicks, lowTicks, closeTicks) : "null"

entryClockEpoch() =>
    barstate.isrealtime ? epochSeconds(timenow) : epochSeconds(time_close)

entryObservedEpoch(EntryAttempt attempt, string model) =>
    model == ENTRY_MODEL_BOC ? attempt.boc.bocObservedAtEpoch : model == ENTRY_MODEL_CLOSE ? attempt.directionalClose.closeObservedAtEpoch : attempt.flip.flipObservedAtEpoch

entryEvaluationEpoch(EntryAttempt attempt) =>
    int result = entryClockEpoch()
    if attempt.boc.bocEmitted and not na(attempt.boc.bocObservedAtEpoch)
        result := math.max(result, attempt.boc.bocObservedAtEpoch)
    if attempt.directionalClose.closeEmitted and not na(attempt.directionalClose.closeObservedAtEpoch)
        result := math.max(result, attempt.directionalClose.closeObservedAtEpoch)
    if attempt.flip.flipEmitted and not na(attempt.flip.flipObservedAtEpoch)
        result := math.max(result, attempt.flip.flipObservedAtEpoch)
    result

entryCandidatePayload(EntryAttempt attempt, RawZone zone, string model) =>
    bool isBoc = model == ENTRY_MODEL_BOC
    int eventAnchor = isBoc ? attempt.core.referenceOpenEpoch : model == ENTRY_MODEL_CLOSE ? attempt.directionalClose.closeOpenEpoch : attempt.flip.flipAnchorEpoch
    string tier = isBoc ? jsonString(attempt.boc.bocTier) : "null"
    string referenceEpoch = isBoc ? str.tostring(attempt.core.referenceOpenEpoch) : "null"
    bool commonExact = attempt.core.commonRulesPass and reviewedProducerHashesValid()
    bool exact = model == ENTRY_MODEL_BOC ? attempt.boc.bocFidelity == "EXACT" and attempt.boc.bocTriggerCausal and commonExact : model == ENTRY_MODEL_CLOSE ? commonExact : attempt.flip.flipFidelity == "EXACT" and attempt.flip.flipTriggerCausal and attempt.flip.flipLifecycleCausal and commonExact
    string state = commonExact and (exact or (isBoc and attempt.boc.bocTier == BOC_TIER_DISCRETIONARY and attempt.boc.bocFidelity == "DISCRETIONARY")) ? "MATCHED" : "BLOCKED"
    "{" +
     "\"candidate_id\":" + jsonString(entryCandidateId(model)) + "," +
     "\"setup_id\":" + jsonString(attempt.core.setupId) + "," +
     "\"model\":" + jsonString(model) + "," +
     "\"state\":" + jsonString(state) + "," +
     "\"direction\":" + jsonString(attempt.core.demand ? "LONG" : "SHORT") + "," +
     "\"event_anchor_epoch\":" + str.tostring(eventAnchor) + "," +
     "\"trigger_ordinal\":1," +
     "\"boc_tier\":" + tier + "," +
     "\"reference_candle_open_epoch\":" + referenceEpoch + "," +
     "\"source_claim_ids\":" + entrySourceClaims(model, attempt.boc.bocTier) + "," +
     "\"observed_at_epoch\":" + str.tostring(entryObservedEpoch(attempt, model)) + "}"

entryEvidencePayload(EntryAttempt attempt, RawZone zone, string model) =>
    bool isBoc = model == ENTRY_MODEL_BOC
    bool isClose = model == ENTRY_MODEL_CLOSE
    bool commonExact = attempt.core.commonRulesPass and reviewedProducerHashesValid()
    bool triggerCausal = isBoc ? attempt.boc.bocTriggerCausal : isClose ? true : attempt.flip.flipTriggerCausal
    bool lifecycleCausal = model == ENTRY_MODEL_FLIP and attempt.flip.flipLifecycleCausal
    bool exact = isBoc ? attempt.boc.bocFidelity == "EXACT" and triggerCausal and commonExact : isClose ? commonExact : attempt.flip.flipFidelity == "EXACT" and triggerCausal and lifecycleCausal and commonExact
    int triggerEpoch = isBoc ? attempt.boc.bocEventEpoch : isClose ? attempt.directionalClose.closeEventEpoch : attempt.flip.flipEventEpoch
    int triggerSequence = isBoc ? attempt.boc.bocEventSequence : isClose ? attempt.directionalClose.closeEventSequence : attempt.flip.flipEventSequence
    int triggerTicks = isBoc ? attempt.boc.bocEventTicks : isClose ? attempt.directionalClose.closeEventTicks : attempt.flip.flipEventTicks
    string fidelity = exact ? "EXACT" : commonExact and isBoc and attempt.boc.bocTier == BOC_TIER_DISCRETIONARY and attempt.boc.bocFidelity == "DISCRETIONARY" ? "DISCRETIONARY" : "UNRESOLVED"
    string proofPlane = isClose ? ENTRY_CONFIRMED_PLANE : isBoc ? attempt.boc.bocProofPlane : attempt.flip.flipProofPlane
    string replayability = isClose ? ENTRY_REPLAYABLE : isBoc ? attempt.boc.bocReplayability : attempt.flip.flipReplayability
    int coverageStart = isBoc ? attempt.boc.bocCoverageStartEpoch : isClose ? attempt.directionalClose.closeOpenEpoch : attempt.flip.flipCoverageStartEpoch
    int coverageEnd = isBoc ? attempt.boc.bocCoverageEndEpoch : isClose ? attempt.directionalClose.closeEventEpoch : attempt.flip.flipCoverageEndEpoch
    string contexts = isBoc ? entryHtfContexts(attempt.boc.bocContextMask) : isClose ? "[]" : entryHtfContexts(attempt.flip.flipContextMask)
    string referenceOpenEpoch = isBoc ? str.tostring(attempt.core.referenceOpenEpoch) : "null"
    string referenceOpenTicks = isBoc ? str.tostring(attempt.core.referenceOpenTicks) : "null"
    string referenceHighTicks = isBoc ? str.tostring(attempt.core.referenceHighTicks) : "null"
    string referenceLowTicks = isBoc ? str.tostring(attempt.core.referenceLowTicks) : "null"
    string referenceCloseTicks = isBoc ? str.tostring(attempt.core.referenceCloseTicks) : "null"
    string htfOpenTicks = model == ENTRY_MODEL_FLIP ? nullableEntryInt(lifecycleCausal, attempt.flip.flipOpenTicks) : "null"
    string contactCandle = model == ENTRY_MODEL_FLIP ? nullableOrderedCandlePayload(lifecycleCausal, attempt.flip.flipContactOpenEpoch, attempt.flip.flipContactCloseEpoch, attempt.flip.flipContactOpenTicks, attempt.flip.flipContactHighTicks, attempt.flip.flipContactLowTicks, attempt.flip.flipContactCloseTicks) : "null"
    string recrossCandle = model == ENTRY_MODEL_FLIP ? nullableOrderedCandlePayload(lifecycleCausal, attempt.flip.flipRecrossOpenEpoch, attempt.flip.flipRecrossCloseEpoch, attempt.flip.flipRecrossOpenTicks, attempt.flip.flipRecrossHighTicks, attempt.flip.flipRecrossLowTicks, attempt.flip.flipRecrossCloseTicks) : "null"
    string lifecycleFlag = model == ENTRY_MODEL_FLIP ? nullableEntryBool(lifecycleCausal, attempt.flip.flipCoverageGapDetected) : "null"
    string lifecycleOrdered = model == ENTRY_MODEL_FLIP ? nullableEntryBool(lifecycleCausal, attempt.flip.flipFullLifecycleOrdered) : "null"
    string destinationBeforeContact = model == ENTRY_MODEL_FLIP ? nullableEntryBool(lifecycleCausal, false) : "null"
    string ambiguities = exact or isClose ? "[]" : model == ENTRY_MODEL_FLIP and attempt.flip.flipFailureCode == "HTF_FLIP_INCOMPATIBLE_CONTEXTS" ? "[]" : "[\"" + (isBoc ? attempt.boc.bocAmbiguityCode : attempt.flip.flipAmbiguityCode) + "\"]"
    string payloadSha = "EDGE_DERIVED"
    "{" +
     "\"evidence_id\":" + jsonString(entryEvidenceId(model)) + "," +
     "\"candidate_id\":" + jsonString(entryCandidateId(model)) + "," +
     "\"observed_trigger_epoch\":" + nullableEntryInt(triggerCausal, triggerEpoch) + "," +
     "\"trigger_sequence\":" + str.tostring(triggerSequence) + "," +
     "\"observed_trigger_ticks\":" + nullableEntryInt(triggerCausal, triggerTicks) + "," +
     "\"htf_context_minutes\":" + contexts + "," +
     "\"fidelity\":" + jsonString(fidelity) + "," +
     "\"proof_plane\":" + jsonString(proofPlane) + "," +
     "\"replayability\":" + jsonString(replayability) + "," +
     "\"coverage_start_epoch\":" + str.tostring(coverageStart) + "," +
     "\"coverage_end_epoch\":" + str.tostring(coverageEnd) + "," +
     "\"ambiguity_codes\":" + ambiguities + "," +
     "\"boc_tier\":" + (isBoc ? jsonString(attempt.boc.bocTier) : "null") + "," +
     "\"reference_candle_open_epoch\":" + referenceOpenEpoch + "," +
     "\"reference_candle_open_ticks\":" + referenceOpenTicks + "," +
     "\"reference_candle_high_ticks\":" + referenceHighTicks + "," +
     "\"reference_candle_low_ticks\":" + referenceLowTicks + "," +
     "\"reference_candle_close_ticks\":" + referenceCloseTicks + "," +
     "\"htf_open_ticks\":" + htfOpenTicks + "," +
     "\"contact_candle\":" + contactCandle + "," +
     "\"recross_candle\":" + recrossCandle + "," +
     "\"coverage_gap_detected\":" + lifecycleFlag + "," +
     "\"full_lifecycle_ordered\":" + lifecycleOrdered + "," +
     "\"destination_seen_before_contact\":" + destinationBeforeContact + "," +
     "\"passed_rule_ids\":" + entryPassedRules(model, exact) + "," +
     "\"failed_rule_ids\":" + entryFailedRules(attempt, model, attempt.boc.bocTier, exact, commonExact) + "," +
     "\"source_claim_ids\":" + entrySourceClaims(model, attempt.boc.bocTier) + "," +
     "\"payload_sha256\":" + jsonString(payloadSha) + "," +
     "\"observed_at_epoch\":" + str.tostring(entryObservedEpoch(attempt, model)) + "}"

entryCandidatesPayload(EntryAttempt attempt, RawZone zone) =>
    string payload = ""
    if attempt.boc.bocEmitted
        payload := entryCandidatePayload(attempt, zone, ENTRY_MODEL_BOC)
    if attempt.directionalClose.closeEmitted
        string item = entryCandidatePayload(attempt, zone, ENTRY_MODEL_CLOSE)
        payload := str.length(payload) == 0 ? item : payload + "," + item
    if attempt.flip.flipEmitted
        string item = entryCandidatePayload(attempt, zone, ENTRY_MODEL_FLIP)
        payload := str.length(payload) == 0 ? item : payload + "," + item
    "[" + payload + "]"

entryEvidenceListPayload(EntryAttempt attempt, RawZone zone) =>
    string payload = ""
    if attempt.boc.bocEmitted
        payload := entryEvidencePayload(attempt, zone, ENTRY_MODEL_BOC)
    if attempt.directionalClose.closeEmitted
        string item = entryEvidencePayload(attempt, zone, ENTRY_MODEL_CLOSE)
        payload := str.length(payload) == 0 ? item : payload + "," + item
    if attempt.flip.flipEmitted
        string item = entryEvidencePayload(attempt, zone, ENTRY_MODEL_FLIP)
        payload := str.length(payload) == 0 ? item : payload + "," + item
    "[" + payload + "]"

entryCandidateIds(EntryAttempt attempt) =>
    string ids = ""
    if attempt.boc.bocEmitted
        ids := jsonString(entryCandidateId(ENTRY_MODEL_BOC))
    if attempt.directionalClose.closeEmitted
        string item = jsonString(entryCandidateId(ENTRY_MODEL_CLOSE))
        ids := str.length(ids) == 0 ? item : ids + "," + item
    if attempt.flip.flipEmitted
        string item = jsonString(entryCandidateId(ENTRY_MODEL_FLIP))
        ids := str.length(ids) == 0 ? item : ids + "," + item
    "[" + ids + "]"

entrySelectionPayload(EntryAttempt attempt) =>
    bool commonExact = attempt.core.commonRulesPass and reviewedProducerHashesValid()
    bool bocExact = attempt.boc.bocEmitted and attempt.boc.bocFidelity == "EXACT" and attempt.boc.bocTriggerCausal and commonExact
    bool closeExact = attempt.directionalClose.closeEmitted and commonExact
    bool flipExact = attempt.flip.flipEmitted and attempt.flip.flipFidelity == "EXACT" and attempt.flip.flipTriggerCausal and attempt.flip.flipLifecycleCausal and commonExact
    int exactCount = (bocExact ? 1 : 0) + (closeExact ? 1 : 0) + (flipExact ? 1 : 0)
    int selectedEpoch = na
    int selectedSequence = na
    int selectedTicks = na
    string selectedModel = ""
    if bocExact
        selectedEpoch := attempt.boc.bocEventEpoch
        selectedSequence := attempt.boc.bocEventSequence
        selectedTicks := attempt.boc.bocEventTicks
        selectedModel := ENTRY_MODEL_BOC
    if closeExact and (na(selectedEpoch) or attempt.directionalClose.closeEventEpoch < selectedEpoch or attempt.directionalClose.closeEventEpoch == selectedEpoch and attempt.directionalClose.closeEventSequence < selectedSequence)
        selectedEpoch := attempt.directionalClose.closeEventEpoch
        selectedSequence := attempt.directionalClose.closeEventSequence
        selectedTicks := attempt.directionalClose.closeEventTicks
        selectedModel := ENTRY_MODEL_CLOSE
    if flipExact and (na(selectedEpoch) or attempt.flip.flipEventEpoch < selectedEpoch or attempt.flip.flipEventEpoch == selectedEpoch and attempt.flip.flipEventSequence < selectedSequence)
        selectedEpoch := attempt.flip.flipEventEpoch
        selectedSequence := attempt.flip.flipEventSequence
        selectedTicks := attempt.flip.flipEventTicks
        selectedModel := ENTRY_MODEL_FLIP
    bool bocSameEvent = bocExact and attempt.boc.bocEventEpoch == selectedEpoch and attempt.boc.bocEventSequence == selectedSequence
    bool closeSameEvent = closeExact and attempt.directionalClose.closeEventEpoch == selectedEpoch and attempt.directionalClose.closeEventSequence == selectedSequence
    bool flipSameEvent = flipExact and attempt.flip.flipEventEpoch == selectedEpoch and attempt.flip.flipEventSequence == selectedSequence
    int sameEventCount = (bocSameEvent ? 1 : 0) + (closeSameEvent ? 1 : 0) + (flipSameEvent ? 1 : 0)
    bool priceConflict = (bocSameEvent and attempt.boc.bocEventTicks != selectedTicks) or (closeSameEvent and attempt.directionalClose.closeEventTicks != selectedTicks) or (flipSameEvent and attempt.flip.flipEventTicks != selectedTicks)
    bool blockedAggressive = closeExact and (attempt.boc.bocEmitted and not bocExact or attempt.flip.flipEmitted and not flipExact)
    bool canonicalUnknown = sameEventCount > 1 and not priceConflict
    bool anyCandidateEmitted = attempt.boc.bocEmitted or attempt.directionalClose.closeEmitted or attempt.flip.flipEmitted
    bool oneCandleExperiment = attempt.core.liquidityCohort == LIQUIDITY_COHORT_ONE
    string reason = exactCount == 0 ? (attempt.boc.bocEmitted or attempt.directionalClose.closeEmitted or attempt.flip.flipEmitted ? "NO_EXACT_CANDIDATE" : "NO_CANDIDATE") :
     priceConflict ? "CO_TRIGGER_PRICE_CONFLICT" :
     sameEventCount > 1 ? "CO_TRIGGER_SAME_EVENT" :
     exactCount == 1 and selectedModel == ENTRY_MODEL_CLOSE ? (blockedAggressive ? "FALLBACK_TO_CONFIRMED_CLOSE" : "ONLY_EXACT_TRIGGER") :
     exactCount == 1 ? "ONLY_EXACT_TRIGGER" : "EARLIEST_EXACT_TRIGGER"
    string action = canonicalUnknown ? "OBSERVE" : exactCount == 0 ? (attempt.boc.bocEmitted or attempt.directionalClose.closeEmitted or attempt.flip.flipEmitted ? "SHADOW_ONLY" : "NONE") : priceConflict ? "SHADOW_ONLY" : "PAPER_ELIGIBLE"
    string candidateId = canonicalUnknown or str.length(selectedModel) == 0 or priceConflict ? "null" : jsonString(entryCandidateId(selectedModel))
    string evidenceId = canonicalUnknown or str.length(selectedModel) == 0 or priceConflict ? "null" : jsonString(entryEvidenceId(selectedModel))
    string model = canonicalUnknown or str.length(selectedModel) == 0 or priceConflict ? "null" : jsonString(selectedModel)
    string fidelity = canonicalUnknown or str.length(selectedModel) == 0 or priceConflict ? "null" : "\"EXACT\""
    if oneCandleExperiment
        candidateId := "null"
        evidenceId := "null"
        model := "null"
        fidelity := "null"
        if attempt.core.invalidatedBeforeEntry
            reason := "SETUP_INVALIDATED"
            action := "NONE"
        else if not anyCandidateEmitted
            reason := "NO_CANDIDATE"
            action := "NONE"
        else
            reason := "NO_EXACT_CANDIDATE"
            action := "SHADOW_ONLY"
    string coModels = sameEventCount > 1 and not priceConflict ? (bocSameEvent and closeSameEvent and flipSameEvent ? "[\"BOC\",\"DIR_CLOSE\",\"HTF_FLIP\"]" : bocSameEvent and closeSameEvent ? "[\"BOC\",\"DIR_CLOSE\"]" : bocSameEvent and flipSameEvent ? "[\"BOC\",\"HTF_FLIP\"]" : "[\"DIR_CLOSE\",\"HTF_FLIP\"]") : "[]"
    if oneCandleExperiment
        coModels := "[]"
    "{" +
     "\"selection_id\":\"EDGE_DERIVED\"," +
     "\"setup_id\":" + jsonString(attempt.core.setupId) + "," +
     "\"policy_version\":" + jsonString(ENTRY_POLICY_VERSION) + "," +
     "\"revision\":" + str.tostring(currentEntrySequence()) + "," +
     "\"candidate_ids_considered\":" + entryCandidateIds(attempt) + "," +
     "\"canonical_candidate_id\":" + candidateId + "," +
     "\"canonical_evidence_id\":" + evidenceId + "," +
     "\"canonical_model\":" + model + "," +
     "\"reason\":" + jsonString(reason) + "," +
     "\"fidelity\":" + fidelity + "," +
     "\"action\":" + jsonString(action) + "," +
     "\"co_triggered_models\":" + coModels + "," +
     "\"evaluated_at_epoch\":" + str.tostring(entryEvaluationEpoch(attempt)) + "}"

entrySelectedFacts(EntryAttempt attempt) =>
    bool commonExact = attempt.core.commonRulesPass and reviewedProducerHashesValid()
    bool bocExact = attempt.boc.bocEmitted and attempt.boc.bocFidelity == "EXACT" and attempt.boc.bocTriggerCausal and commonExact
    bool closeExact = attempt.directionalClose.closeEmitted and commonExact
    bool flipExact = attempt.flip.flipEmitted and attempt.flip.flipFidelity == "EXACT" and attempt.flip.flipTriggerCausal and attempt.flip.flipLifecycleCausal and commonExact
    int selectedEpoch = na
    int selectedSequence = na
    int selectedTicks = na
    if bocExact
        selectedEpoch := attempt.boc.bocEventEpoch
        selectedSequence := attempt.boc.bocEventSequence
        selectedTicks := attempt.boc.bocEventTicks
    if closeExact and (na(selectedEpoch) or attempt.directionalClose.closeEventEpoch < selectedEpoch or attempt.directionalClose.closeEventEpoch == selectedEpoch and attempt.directionalClose.closeEventSequence < selectedSequence)
        selectedEpoch := attempt.directionalClose.closeEventEpoch
        selectedSequence := attempt.directionalClose.closeEventSequence
        selectedTicks := attempt.directionalClose.closeEventTicks
    if flipExact and (na(selectedEpoch) or attempt.flip.flipEventEpoch < selectedEpoch or attempt.flip.flipEventEpoch == selectedEpoch and attempt.flip.flipEventSequence < selectedSequence)
        selectedEpoch := attempt.flip.flipEventEpoch
        selectedSequence := attempt.flip.flipEventSequence
        selectedTicks := attempt.flip.flipEventTicks
    if na(selectedEpoch)
        selectedEpoch := attempt.boc.bocEmitted ? attempt.boc.bocEventEpoch : attempt.directionalClose.closeEmitted ? attempt.directionalClose.closeEventEpoch : attempt.flip.flipEventEpoch
        selectedSequence := attempt.boc.bocEmitted ? attempt.boc.bocEventSequence : attempt.directionalClose.closeEmitted ? attempt.directionalClose.closeEventSequence : attempt.flip.flipEventSequence
        selectedTicks := attempt.boc.bocEmitted ? attempt.boc.bocEventTicks : attempt.directionalClose.closeEmitted ? attempt.directionalClose.closeEventTicks : attempt.flip.flipEventTicks
    [selectedEpoch, selectedSequence, selectedTicks]

entryHasPaperEligibleSelection(EntryAttempt attempt) =>
    bool commonExact = attempt.core.commonRulesPass and reviewedProducerHashesValid()
    bool bocExact = attempt.boc.bocEmitted and attempt.boc.bocFidelity == "EXACT" and attempt.boc.bocTriggerCausal and commonExact
    bool closeExact = attempt.directionalClose.closeEmitted and commonExact
    bool flipExact = attempt.flip.flipEmitted and attempt.flip.flipFidelity == "EXACT" and attempt.flip.flipTriggerCausal and attempt.flip.flipLifecycleCausal and commonExact
    [selectedEpoch, selectedSequence, selectedTicks] = entrySelectedFacts(attempt)
    bool bocConflict = bocExact and attempt.boc.bocEventEpoch == selectedEpoch and attempt.boc.bocEventSequence == selectedSequence and attempt.boc.bocEventTicks != selectedTicks
    bool closeConflict = closeExact and attempt.directionalClose.closeEventEpoch == selectedEpoch and attempt.directionalClose.closeEventSequence == selectedSequence and attempt.directionalClose.closeEventTicks != selectedTicks
    bool flipConflict = flipExact and attempt.flip.flipEventEpoch == selectedEpoch and attempt.flip.flipEventSequence == selectedSequence and attempt.flip.flipEventTicks != selectedTicks
    not na(selectedEpoch) and (bocExact or closeExact or flipExact) and not (bocConflict or closeConflict or flipConflict)

entryBundleReadyToEmit(EntryAttempt attempt) =>
    not attempt.boc.bocAuditPending and not attempt.flip.flipAuditPending and
     (not attempt.boc.bocEmitted or not na(attempt.boc.bocObservedAtEpoch)) and
     (not attempt.directionalClose.closeEmitted or not na(attempt.directionalClose.closeObservedAtEpoch)) and
     (not attempt.flip.flipEmitted or not na(attempt.flip.flipObservedAtEpoch))

entrySetupBundlePayload(EntryAttempt attempt, RawZone zone) =>
    [selectedEpoch, selectedSequence, selectedTicks] = entrySelectedFacts(attempt)
    int stopTicks = attempt.core.demand ? selectedTicks - entryStopTicks : selectedTicks + entryStopTicks
    int targetTicks = attempt.core.demand ? selectedTicks + entryTargetTicks : selectedTicks - entryTargetTicks
    bool commonRulesPass = attempt.core.commonRulesPass
    bool reviewedHashesValid = reviewedProducerHashesValid()
    bool oneCandleLiquidity = attempt.core.liquidityCohort == LIQUIDITY_COHORT_ONE
    string commonFidelity = oneCandleLiquidity ? (commonRulesPass ? "DISCRETIONARY" : "UNRESOLVED") : commonRulesPass and reviewedHashesValid ? "EXACT" : "UNRESOLVED"
    "{" +
     "\"setup\":{" +
     "\"setup_id\":" + jsonString(attempt.core.setupId) + "," +
     "\"direction\":" + jsonString(attempt.core.demand ? "LONG" : "SHORT") + "," +
     "\"liquidity_cohort\":" + jsonString(attempt.core.liquidityCohort) + "," +
     "\"one_candle_enabled\":" + str.tostring(enableOneCandleLiquidity) + "," +
     "\"zone_top_ticks\":" + str.tostring(attempt.core.zoneTopTicks) + "," +
     "\"zone_bottom_ticks\":" + str.tostring(attempt.core.zoneBottomTicks) + "," +
     "\"zone_engaged_epoch\":" + str.tostring(attempt.core.engagementEpoch) + "," +
     "\"invalidated_before_entry\":" + str.tostring(attempt.core.invalidatedBeforeEntry) + "," +
     "\"common_fidelity\":" + jsonString(commonFidelity) + "," +
     "\"common_rule_results\":" + commonRuleResultsPayload(attempt) + "}," +
     "\"candidates\":" + entryCandidatesPayload(attempt, zone) + "," +
     "\"evidence\":" + entryEvidenceListPayload(attempt, zone) + "," +
     "\"selection_proposal\":" + entrySelectionPayload(attempt) + "," +
     "\"trade_plan\":{" +
     "\"direction\":" + jsonString(attempt.core.demand ? "LONG" : "SHORT") + "," +
     "\"entry_ticks\":" + str.tostring(selectedTicks) + "," +
     "\"stop_ticks\":" + str.tostring(stopTicks) + "," +
     "\"target_ticks\":" + str.tostring(targetTicks) + "}}"

entryMarketEventPayload(EntryAttempt attempt, bool historicalAmbiguousExit) =>
    [selectedEpoch, selectedSequence, selectedTicks] = entrySelectedFacts(attempt)
    bool closeSelected = not historicalAmbiguousExit and attempt.directionalClose.closeEmitted and selectedEpoch == attempt.directionalClose.closeEventEpoch and selectedSequence == attempt.directionalClose.closeEventSequence
    int marketEpoch = historicalAmbiguousExit ? epochSeconds(time_close) : selectedEpoch
    int marketSequence = historicalAmbiguousExit ? tickSequence : selectedSequence
    int marketTicks = historicalAmbiguousExit ? priceTicks(close) : selectedTicks
    bool confirmedSelected = historicalAmbiguousExit or closeSelected
    string confirmed = historicalAmbiguousExit ? orderedCandlePayload(epochSeconds(time), epochSeconds(time_close), priceTicks(open), priceTicks(high), priceTicks(low), priceTicks(close)) : closeSelected ? orderedCandlePayload(attempt.directionalClose.closeOpenEpoch, attempt.directionalClose.closeEventEpoch, attempt.directionalClose.closeOpenTicks, attempt.directionalClose.closeHighTicks, attempt.directionalClose.closeLowTicks, attempt.directionalClose.closeCloseTicks) : "null"
    "{" +
     "\"epoch\":" + str.tostring(marketEpoch) + "," +
     "\"sequence\":" + str.tostring(marketSequence) + "," +
     "\"tick_price_ticks\":" + str.tostring(marketTicks) + "," +
     "\"barstate_isconfirmed\":" + str.tostring(confirmedSelected) + "," +
     "\"confirmed_bar\":" + confirmed + "}"

entryPayload(EntryAttempt attempt, RawZone zone, string exitEvents, bool historicalAmbiguousExit) =>
    int producerSequence = nextEntrySequence()
    string eventId = entryProducerInstanceId + ":" + str.tostring(producerSequence)
    bool reviewedPromotion = attempt.core.commonRulesPass and reviewedProducerHashesValid()
    string detectorHash = reviewedPromotion ? detectorCodeHash : "UNREVIEWED"
    string settingsHashValue = reviewedPromotion ? settingsHash : "UNREVIEWED"
    "{" +
     "\"schema_version\":" + jsonString(ENTRY_SCHEMA_VERSION) + "," +
     "\"strategy_id\":" + jsonString(ENTRY_STRATEGY_ID) + "," +
     "\"strategy_version\":" + jsonString(ENTRY_STRATEGY_VERSION) + "," +
     "\"rule_contract_version\":" + jsonString(ENTRY_RULE_CONTRACT_VERSION) + "," +
     "\"execution_mode\":" + jsonString(ENTRY_EXECUTION_MODE) + "," +
     "\"producer_instance_id\":" + jsonString(entryProducerInstanceId) + "," +
     "\"producer_sequence\":" + str.tostring(producerSequence) + "," +
     "\"event_id\":" + jsonString(eventId) + "," +
     "\"is_realtime\":" + str.tostring(barstate.isrealtime) + "," +
     "\"symbol\":" + jsonString(setupContractIdentifier(syminfo.ticker)) + "," +
     "\"ticker_id\":" + jsonString(setupContractIdentifier(syminfo.tickerid)) + "," +
     "\"feed\":" + jsonString(setupContractIdentifier(syminfo.prefix)) + "," +
     "\"timeframe\":\"5\"," +
     "\"tick_size\":" + jsonString(str.tostring(syminfo.mintick, format.mintick)) + "," +
     "\"detector_code_hash\":" + jsonString(detectorHash) + "," +
     "\"settings_hash\":" + jsonString(settingsHashValue) + "," +
     "\"observed_at_epoch\":" + str.tostring(entryEvaluationEpoch(attempt)) + "," +
     "\"market_event\":" + entryMarketEventPayload(attempt, historicalAmbiguousExit) + "," +
     "\"exit_events\":" + exitEvents + "," +
     "\"setups\":[" + entrySetupBundlePayload(attempt, zone) + "]}"

emitEntryPayload(EntryAttempt attempt, RawZone zone, bool intrabar, string exitEvents, bool historicalAmbiguousExit) =>
    bool emitted = false
    if emitEntryV3Events and entryCredentialSafe()
        string payload = entryPayload(attempt, zone, exitEvents, historicalAmbiguousExit)
        string envelope = "{\"credential\":" + jsonString(entryV3Credential) + ",\"payload\":" + payload + "}"
        if str.length(envelope) >= ENTRY_MAX_PAYLOAD_CHARS
            log.error("ENTRY_V3_ENVELOPE_TOO_LARGE")
        else
            // The Worker authenticates and validates this complete strict
            // {credential,payload} observation envelope.
            if intrabar
                alert(envelope, alert.freq_all)
            else
                alert(envelope, alert.freq_once_per_bar_close)
            emitted := true
    else if emitEntryV3Events and str.length(entryV3Credential) > 0
        log.error("ENTRY_V3_CREDENTIAL_UNSAFE")
    emitted

recordDirectionalClose(EntryAttempt attempt, RawZone zone) =>
    bool zoneEngaged = not na(attempt.core.engagementEpoch)
    bool directionalClose = barstate.isconfirmed and zoneEngaged and ((zone.demand and close > open and close > zone.top) or (not zone.demand and close < open and close < zone.bottom))
    bool triggered = not attempt.directionalClose.closeEmitted and directionalClose
    if triggered
        attempt.directionalClose.closeEmitted := true
        attempt.directionalClose.closeEventEpoch := epochSeconds(time_close)
        attempt.directionalClose.closeEventSequence := tickSequence
        attempt.directionalClose.closeEventTicks := priceTicks(close)
        attempt.directionalClose.closeOpenEpoch := epochSeconds(time)
        attempt.directionalClose.closeOpenTicks := priceTicks(open)
        attempt.directionalClose.closeHighTicks := priceTicks(high)
        attempt.directionalClose.closeLowTicks := priceTicks(low)
        attempt.directionalClose.closeCloseTicks := priceTicks(close)
        attempt.directionalClose.closeObservedAtEpoch := entryClockEpoch()
        if na(attempt.core.entryTicks)
            attempt.core.entryTicks := attempt.directionalClose.closeEventTicks
    triggered

recordBoc(EntryAttempt attempt, RawZone zone, bool allowNewObservation) =>
    int nowEpoch = entryClockEpoch()
    bool bocTriggered = false
    if attempt.boc.bocAuditPending and nowEpoch > attempt.boc.bocEventEpoch
        attempt.boc.bocAuditPending := false
        attempt.boc.bocCoverageEndEpoch := nowEpoch
        attempt.boc.bocObservedAtEpoch := nowEpoch
        bocTriggered := true
    bool longBreak = attempt.core.demand and close > attempt.core.referenceHighPrice
    bool shortBreak = not attempt.core.demand and close < attempt.core.referenceLowPrice
    bool brokenNow = longBreak or shortBreak
    bool continuousCoverage = attempt.boc.bocCoverageReady and attempt.boc.bocLastTickSequence + 1 == tickSequence
    bool firstCrossObserved = barstate.isrealtime and continuousCoverage and attempt.boc.bocPreviousNonBrokenSide and brokenNow
    bool priorTickCausal = not na(attempt.boc.bocLastTickEpoch) and nowEpoch > attempt.boc.bocLastTickEpoch
    bool exactFirstCross = firstCrossObserved and priorTickCausal
    bool unrepresentableFirstCross = firstCrossObserved and not priorTickCausal
    bool historicalObservedBreak = not barstate.isrealtime and (attempt.core.demand ? high > attempt.core.referenceHighPrice : low < attempt.core.referenceLowPrice)
    bool uncoveredRealtimeBreak = barstate.isrealtime and brokenNow and not firstCrossObserved
    bool newObservation = allowNewObservation and not attempt.boc.bocEmitted and (exactFirstCross or unrepresentableFirstCross or uncoveredRealtimeBreak or historicalObservedBreak)
    if newObservation
        bool opens15 = minute(time) % 15 == 0
        bool opens30 = minute(time) % 30 == 0
        bool opens60 = minute(time) == 0
        bool htfTimed = opens15 or opens30 or opens60
        string bocTier = htfTimed ? BOC_TIER_HTF : BOC_TIER_DISCRETIONARY
        attempt.boc.bocEmitted := true
        attempt.boc.bocEventEpoch := nowEpoch
        attempt.boc.bocEventSequence := tickSequence
        attempt.boc.bocEventTicks := priceTicks(close)
        attempt.boc.bocContextMask := (opens15 ? 1 : 0) + (opens30 ? 2 : 0) + (opens60 ? 4 : 0)
        attempt.boc.bocTier := bocTier
        if na(attempt.boc.bocCoverageStartEpoch)
            attempt.boc.bocCoverageStartEpoch := barstate.isrealtime ? nowEpoch : attempt.core.referenceOpenEpoch
        bool coverageIntervalAdvanced = nowEpoch > attempt.boc.bocCoverageStartEpoch
        attempt.boc.bocTriggerCausal := not unrepresentableFirstCross
        attempt.boc.bocAuditPending := unrepresentableFirstCross or not coverageIntervalAdvanced
        attempt.boc.bocCoverageEndEpoch := attempt.boc.bocAuditPending ? na : nowEpoch
        attempt.boc.bocObservedAtEpoch := attempt.boc.bocAuditPending ? na : nowEpoch
        attempt.boc.bocFidelity := exactFirstCross ? (htfTimed ? "EXACT" : "DISCRETIONARY") : "UNRESOLVED"
        attempt.boc.bocProofPlane := barstate.isrealtime ? ENTRY_REALTIME_PLANE : ENTRY_CONFIRMED_PLANE
        attempt.boc.bocReplayability := barstate.isrealtime ? ENTRY_LIVE_REPLAYABILITY : ENTRY_REPLAYABLE
        attempt.boc.bocCoverageGapDetected := uncoveredRealtimeBreak or not coverageIntervalAdvanced
        attempt.boc.bocAmbiguityCode := uncoveredRealtimeBreak or unrepresentableFirstCross or not coverageIntervalAdvanced ? "SHADOW_MISSING_INTRABAR_COVERAGE" : "SHADOW_SAME_CHILD_BAR_ORDER"
        attempt.boc.bocFailureCode := unrepresentableFirstCross ? "REALTIME_TRIGGER_EPOCH_UNREPRESENTABLE" : uncoveredRealtimeBreak ? "REALTIME_FIRST_CROSS_UNPROVEN" : not coverageIntervalAdvanced ? "REALTIME_TRIGGER_EPOCH_UNREPRESENTABLE" : not barstate.isrealtime ? "HISTORICAL_ORDER_UNPROVEN" : "HISTORICAL_ORDER_UNPROVEN"
        bocTriggered := not attempt.boc.bocAuditPending
        if na(attempt.core.entryTicks)
            attempt.core.entryTicks := attempt.boc.bocEventTicks
    if barstate.isrealtime and not attempt.boc.bocEmitted
        bool coverageGap = not na(attempt.boc.bocLastTickSequence) and attempt.boc.bocLastTickSequence + 1 != tickSequence
        if coverageGap
            attempt.boc.bocCoverageGapDetected := true
            attempt.boc.bocCoverageReady := false
            attempt.boc.bocCoverageStartEpoch := epochSeconds(timenow)
        if na(attempt.boc.bocCoverageStartEpoch)
            attempt.boc.bocCoverageStartEpoch := epochSeconds(timenow)
        attempt.boc.bocPreviousNonBrokenSide := not brokenNow
        attempt.boc.bocLastTickSequence := tickSequence
        attempt.boc.bocLastTickEpoch := epochSeconds(timenow)
        attempt.boc.bocPreviousTickTicks := priceTicks(close)
        attempt.boc.bocCoverageReady := true
    bocTriggered

captureFlipContact(EntryAttempt attempt, int contextMinutes) =>
    int contactEpoch = barstate.isrealtime ? epochSeconds(timenow) : epochSeconds(time)
    int contactCloseEpoch = barstate.isrealtime ? epochSeconds(timenow) : epochSeconds(time_close)
    int contactTicks = priceTicks(close)
    if contextMinutes == 15
        attempt.htf15.htf15ContactSeen := true
        attempt.htf15.htf15ContactOpenEpoch := contactEpoch
        attempt.htf15.htf15ContactCloseEpoch := contactCloseEpoch
        attempt.htf15.htf15ContactOpenTicks := barstate.isrealtime ? contactTicks : priceTicks(open)
        attempt.htf15.htf15ContactHighTicks := barstate.isrealtime ? contactTicks : priceTicks(high)
        attempt.htf15.htf15ContactLowTicks := barstate.isrealtime ? contactTicks : priceTicks(low)
        attempt.htf15.htf15ContactCloseTicks := contactTicks
        attempt.htf15.htf15ContactTickEpoch := epochSeconds(timenow)
        attempt.htf15.htf15ContactTickSequence := tickSequence
    else if contextMinutes == 30
        attempt.htf30.htf30ContactSeen := true
        attempt.htf30.htf30ContactOpenEpoch := contactEpoch
        attempt.htf30.htf30ContactCloseEpoch := contactCloseEpoch
        attempt.htf30.htf30ContactOpenTicks := barstate.isrealtime ? contactTicks : priceTicks(open)
        attempt.htf30.htf30ContactHighTicks := barstate.isrealtime ? contactTicks : priceTicks(high)
        attempt.htf30.htf30ContactLowTicks := barstate.isrealtime ? contactTicks : priceTicks(low)
        attempt.htf30.htf30ContactCloseTicks := contactTicks
        attempt.htf30.htf30ContactTickEpoch := epochSeconds(timenow)
        attempt.htf30.htf30ContactTickSequence := tickSequence
    else
        attempt.htf60.htf60ContactSeen := true
        attempt.htf60.htf60ContactOpenEpoch := contactEpoch
        attempt.htf60.htf60ContactCloseEpoch := contactCloseEpoch
        attempt.htf60.htf60ContactOpenTicks := barstate.isrealtime ? contactTicks : priceTicks(open)
        attempt.htf60.htf60ContactHighTicks := barstate.isrealtime ? contactTicks : priceTicks(high)
        attempt.htf60.htf60ContactLowTicks := barstate.isrealtime ? contactTicks : priceTicks(low)
        attempt.htf60.htf60ContactCloseTicks := contactTicks
        attempt.htf60.htf60ContactTickEpoch := epochSeconds(timenow)
        attempt.htf60.htf60ContactTickSequence := tickSequence
    true

updateFlipContext(EntryAttempt attempt, RawZone zone, int contextMinutes) =>
    if contextMinutes == 15
        attempt.htf15.htf15TriggeredThisTick := false
    else if contextMinutes == 30
        attempt.htf30.htf30TriggeredThisTick := false
    else
        attempt.htf60.htf60TriggeredThisTick := false
    int boundarySeconds = contextMinutes * 60
    int barEpoch = epochSeconds(time)
    bool opensContext = barEpoch % boundarySeconds == 0
    int anchorEpoch = contextMinutes == 15 ? attempt.htf15.htf15AnchorEpoch : contextMinutes == 30 ? attempt.htf30.htf30AnchorEpoch : attempt.htf60.htf60AnchorEpoch
    int openTicks = contextMinutes == 15 ? attempt.htf15.htf15OpenTicks : contextMinutes == 30 ? attempt.htf30.htf30OpenTicks : attempt.htf60.htf60OpenTicks
    bool contactSeen = contextMinutes == 15 ? attempt.htf15.htf15ContactSeen : contextMinutes == 30 ? attempt.htf30.htf30ContactSeen : attempt.htf60.htf60ContactSeen
    bool destinationBeforeContact = contextMinutes == 15 ? attempt.htf15.htf15DestinationBeforeContact : contextMinutes == 30 ? attempt.htf30.htf30DestinationBeforeContact : attempt.htf60.htf60DestinationBeforeContact
    int contactOpenEpoch = contextMinutes == 15 ? attempt.htf15.htf15ContactOpenEpoch : contextMinutes == 30 ? attempt.htf30.htf30ContactOpenEpoch : attempt.htf60.htf60ContactOpenEpoch
    int contactCloseEpoch = contextMinutes == 15 ? attempt.htf15.htf15ContactCloseEpoch : contextMinutes == 30 ? attempt.htf30.htf30ContactCloseEpoch : attempt.htf60.htf60ContactCloseEpoch
    int contactOpenTicks = contextMinutes == 15 ? attempt.htf15.htf15ContactOpenTicks : contextMinutes == 30 ? attempt.htf30.htf30ContactOpenTicks : attempt.htf60.htf60ContactOpenTicks
    int contactHighTicks = contextMinutes == 15 ? attempt.htf15.htf15ContactHighTicks : contextMinutes == 30 ? attempt.htf30.htf30ContactHighTicks : attempt.htf60.htf60ContactHighTicks
    int contactLowTicks = contextMinutes == 15 ? attempt.htf15.htf15ContactLowTicks : contextMinutes == 30 ? attempt.htf30.htf30ContactLowTicks : attempt.htf60.htf60ContactLowTicks
    int contactCloseTicks = contextMinutes == 15 ? attempt.htf15.htf15ContactCloseTicks : contextMinutes == 30 ? attempt.htf30.htf30ContactCloseTicks : attempt.htf60.htf60ContactCloseTicks
    int contactTickEpoch = contextMinutes == 15 ? attempt.htf15.htf15ContactTickEpoch : contextMinutes == 30 ? attempt.htf30.htf30ContactTickEpoch : attempt.htf60.htf60ContactTickEpoch
    int contactTickSequence = contextMinutes == 15 ? attempt.htf15.htf15ContactTickSequence : contextMinutes == 30 ? attempt.htf30.htf30ContactTickSequence : attempt.htf60.htf60ContactTickSequence
    bool coverageReady = contextMinutes == 15 ? attempt.htf15.htf15CoverageReady : contextMinutes == 30 ? attempt.htf30.htf30CoverageReady : attempt.htf60.htf60CoverageReady
    bool previousAtOrInsideOpen = contextMinutes == 15 ? attempt.htf15.htf15PreviousAtOrInsideOpen : contextMinutes == 30 ? attempt.htf30.htf30PreviousAtOrInsideOpen : attempt.htf60.htf60PreviousAtOrInsideOpen
    int lastTickSequence = contextMinutes == 15 ? attempt.htf15.htf15LastTickSequence : contextMinutes == 30 ? attempt.htf30.htf30LastTickSequence : attempt.htf60.htf60LastTickSequence
    int lastTickEpoch = contextMinutes == 15 ? attempt.htf15.htf15LastTickEpoch : contextMinutes == 30 ? attempt.htf30.htf30LastTickEpoch : attempt.htf60.htf60LastTickEpoch
    int previousTickTicks = contextMinutes == 15 ? attempt.htf15.htf15PreviousTickTicks : contextMinutes == 30 ? attempt.htf30.htf30PreviousTickTicks : attempt.htf60.htf60PreviousTickTicks
    int coverageStartEpoch = contextMinutes == 15 ? attempt.htf15.htf15CoverageStartEpoch : contextMinutes == 30 ? attempt.htf30.htf30CoverageStartEpoch : attempt.htf60.htf60CoverageStartEpoch
    bool coverageGapDetected = contextMinutes == 15 ? attempt.htf15.htf15CoverageGapDetected : contextMinutes == 30 ? attempt.htf30.htf30CoverageGapDetected : attempt.htf60.htf60CoverageGapDetected
    if opensContext and anchorEpoch != barEpoch
        anchorEpoch := barEpoch
        openTicks := priceTicks(open)
        contactSeen := false
        destinationBeforeContact := false
        coverageReady := false
        previousAtOrInsideOpen := false
        lastTickSequence := na
        lastTickEpoch := na
        previousTickTicks := na
        coverageStartEpoch := barstate.isrealtime ? epochSeconds(timenow) : barEpoch
        coverageGapDetected := not barstate.isrealtime
        if contextMinutes == 15
            attempt.htf15.htf15AnchorEpoch := anchorEpoch
            attempt.htf15.htf15OpenTicks := openTicks
            attempt.htf15.htf15ContactSeen := false
            attempt.htf15.htf15DestinationBeforeContact := false
            attempt.htf15.htf15ContactOpenEpoch := na
            attempt.htf15.htf15ContactCloseEpoch := na
            attempt.htf15.htf15ContactOpenTicks := na
            attempt.htf15.htf15ContactHighTicks := na
            attempt.htf15.htf15ContactLowTicks := na
            attempt.htf15.htf15ContactCloseTicks := na
            attempt.htf15.htf15ContactTickEpoch := na
            attempt.htf15.htf15ContactTickSequence := na
            attempt.htf15.htf15CoverageReady := false
            attempt.htf15.htf15PreviousAtOrInsideOpen := false
            attempt.htf15.htf15LastTickSequence := na
            attempt.htf15.htf15LastTickEpoch := na
            attempt.htf15.htf15PreviousTickTicks := na
            attempt.htf15.htf15CoverageStartEpoch := coverageStartEpoch
            attempt.htf15.htf15CoverageGapDetected := coverageGapDetected
        else if contextMinutes == 30
            attempt.htf30.htf30AnchorEpoch := anchorEpoch
            attempt.htf30.htf30OpenTicks := openTicks
            attempt.htf30.htf30ContactSeen := false
            attempt.htf30.htf30DestinationBeforeContact := false
            attempt.htf30.htf30ContactOpenEpoch := na
            attempt.htf30.htf30ContactCloseEpoch := na
            attempt.htf30.htf30ContactOpenTicks := na
            attempt.htf30.htf30ContactHighTicks := na
            attempt.htf30.htf30ContactLowTicks := na
            attempt.htf30.htf30ContactCloseTicks := na
            attempt.htf30.htf30ContactTickEpoch := na
            attempt.htf30.htf30ContactTickSequence := na
            attempt.htf30.htf30CoverageReady := false
            attempt.htf30.htf30PreviousAtOrInsideOpen := false
            attempt.htf30.htf30LastTickSequence := na
            attempt.htf30.htf30LastTickEpoch := na
            attempt.htf30.htf30PreviousTickTicks := na
            attempt.htf30.htf30CoverageStartEpoch := coverageStartEpoch
            attempt.htf30.htf30CoverageGapDetected := coverageGapDetected
        else
            attempt.htf60.htf60AnchorEpoch := anchorEpoch
            attempt.htf60.htf60OpenTicks := openTicks
            attempt.htf60.htf60ContactSeen := false
            attempt.htf60.htf60DestinationBeforeContact := false
            attempt.htf60.htf60ContactOpenEpoch := na
            attempt.htf60.htf60ContactCloseEpoch := na
            attempt.htf60.htf60ContactOpenTicks := na
            attempt.htf60.htf60ContactHighTicks := na
            attempt.htf60.htf60ContactLowTicks := na
            attempt.htf60.htf60ContactCloseTicks := na
            attempt.htf60.htf60ContactTickEpoch := na
            attempt.htf60.htf60ContactTickSequence := na
            attempt.htf60.htf60CoverageReady := false
            attempt.htf60.htf60PreviousAtOrInsideOpen := false
            attempt.htf60.htf60LastTickSequence := na
            attempt.htf60.htf60LastTickEpoch := na
            attempt.htf60.htf60PreviousTickTicks := na
            attempt.htf60.htf60CoverageStartEpoch := coverageStartEpoch
            attempt.htf60.htf60CoverageGapDetected := coverageGapDetected
        contactOpenEpoch := na
        contactCloseEpoch := na
        contactOpenTicks := na
        contactHighTicks := na
        contactLowTicks := na
        contactCloseTicks := na
        contactTickEpoch := na
        contactTickSequence := na
    bool activeContext = not na(anchorEpoch) and barEpoch < anchorEpoch + boundarySeconds
    bool zoneContact = activeContext and (barstate.isrealtime ? close <= zone.top and close >= zone.bottom : low <= zone.top and high >= zone.bottom)
    bool destinationSeen = activeContext and (attempt.core.demand ? (barstate.isrealtime ? close > openTicks * syminfo.mintick : high > openTicks * syminfo.mintick) : (barstate.isrealtime ? close < openTicks * syminfo.mintick : low < openTicks * syminfo.mintick))
    bool continuousCoverage = coverageReady and lastTickSequence + 1 == tickSequence
    int nowEpoch = entryClockEpoch()
    bool contactWasSeen = contactSeen
    if activeContext and not contactSeen and destinationSeen
        destinationBeforeContact := true
        if contextMinutes == 15
            attempt.htf15.htf15DestinationBeforeContact := true
        else if contextMinutes == 30
            attempt.htf30.htf30DestinationBeforeContact := true
        else
            attempt.htf60.htf60DestinationBeforeContact := true
    if activeContext and zoneContact and not contactSeen
        captureFlipContact(attempt, contextMinutes)
        contactSeen := true
        contactOpenEpoch := barstate.isrealtime ? epochSeconds(timenow) : barEpoch
        contactCloseEpoch := barstate.isrealtime ? epochSeconds(timenow) : epochSeconds(time_close)
        contactOpenTicks := barstate.isrealtime ? priceTicks(close) : priceTicks(open)
        contactHighTicks := barstate.isrealtime ? priceTicks(close) : priceTicks(high)
        contactLowTicks := barstate.isrealtime ? priceTicks(close) : priceTicks(low)
        contactCloseTicks := priceTicks(close)
        contactTickEpoch := epochSeconds(timenow)
        contactTickSequence := tickSequence
        bool contactCoverageContinuous = barstate.isrealtime and continuousCoverage and not na(lastTickEpoch) and lastTickEpoch < nowEpoch
        if contactCoverageContinuous
            contactOpenEpoch := lastTickEpoch
            contactCloseEpoch := nowEpoch
            contactOpenTicks := previousTickTicks
            contactHighTicks := math.max(previousTickTicks, priceTicks(close))
            contactLowTicks := math.min(previousTickTicks, priceTicks(close))
            if contextMinutes == 15
                attempt.htf15.htf15ContactOpenEpoch := contactOpenEpoch
                attempt.htf15.htf15ContactCloseEpoch := contactCloseEpoch
                attempt.htf15.htf15ContactOpenTicks := contactOpenTicks
                attempt.htf15.htf15ContactHighTicks := contactHighTicks
                attempt.htf15.htf15ContactLowTicks := contactLowTicks
            else if contextMinutes == 30
                attempt.htf30.htf30ContactOpenEpoch := contactOpenEpoch
                attempt.htf30.htf30ContactCloseEpoch := contactCloseEpoch
                attempt.htf30.htf30ContactOpenTicks := contactOpenTicks
                attempt.htf30.htf30ContactHighTicks := contactHighTicks
                attempt.htf30.htf30ContactLowTicks := contactLowTicks
            else
                attempt.htf60.htf60ContactOpenEpoch := contactOpenEpoch
                attempt.htf60.htf60ContactCloseEpoch := contactCloseEpoch
                attempt.htf60.htf60ContactOpenTicks := contactOpenTicks
                attempt.htf60.htf60ContactHighTicks := contactHighTicks
                attempt.htf60.htf60ContactLowTicks := contactLowTicks
        else if barstate.isrealtime
            coverageGapDetected := true
            if contextMinutes == 15
                attempt.htf15.htf15CoverageGapDetected := true
            else if contextMinutes == 30
                attempt.htf30.htf30CoverageGapDetected := true
            else
                attempt.htf60.htf60CoverageGapDetected := true
    bool laterThanContact = not na(contactTickEpoch) and not na(contactTickSequence) and tickSequence > contactTickSequence and nowEpoch > contactTickEpoch
    bool currentAtOrInsideOpen = attempt.core.demand ? close <= openTicks * syminfo.mintick : close >= openTicks * syminfo.mintick
    bool sameChildExactRecross = barstate.isrealtime and contactSeen and contactTickEpoch >= barEpoch and contactTickEpoch < epochSeconds(time_close) and laterThanContact and continuousCoverage and not coverageGapDetected and previousAtOrInsideOpen and destinationSeen
    bool sameAtomicContactAndDestination = barstate.isrealtime and contactSeen and destinationSeen and not laterThanContact
    if sameAtomicContactAndDestination
        destinationBeforeContact := true
        if contextMinutes == 15
            attempt.htf15.htf15DestinationBeforeContact := true
        else if contextMinutes == 30
            attempt.htf30.htf30DestinationBeforeContact := true
        else
            attempt.htf60.htf60DestinationBeforeContact := true
    if contactSeen and barstate.isrealtime and not sameChildExactRecross and laterThanContact
        contactHighTicks := math.max(contactHighTicks, priceTicks(close))
        contactLowTicks := math.min(contactLowTicks, priceTicks(close))
        contactCloseTicks := priceTicks(close)
        contactCloseEpoch := nowEpoch
        if contextMinutes == 15
            attempt.htf15.htf15ContactHighTicks := contactHighTicks
            attempt.htf15.htf15ContactLowTicks := contactLowTicks
            attempt.htf15.htf15ContactCloseTicks := contactCloseTicks
            attempt.htf15.htf15ContactCloseEpoch := contactCloseEpoch
        else if contextMinutes == 30
            attempt.htf30.htf30ContactHighTicks := contactHighTicks
            attempt.htf30.htf30ContactLowTicks := contactLowTicks
            attempt.htf30.htf30ContactCloseTicks := contactCloseTicks
            attempt.htf30.htf30ContactCloseEpoch := contactCloseEpoch
        else
            attempt.htf60.htf60ContactHighTicks := contactHighTicks
            attempt.htf60.htf60ContactLowTicks := contactLowTicks
            attempt.htf60.htf60ContactCloseTicks := contactCloseTicks
            attempt.htf60.htf60ContactCloseEpoch := contactCloseEpoch
    bool contactCandleComplete = contactWasSeen and barEpoch >= contactCloseEpoch
    bool exactFirstRecross = barstate.isrealtime and continuousCoverage and previousAtOrInsideOpen and destinationSeen
    bool historicalRecross = not barstate.isrealtime and activeContext and contactCandleComplete and not destinationBeforeContact and destinationSeen
    bool flipTriggered = not attempt.flip.flipEmitted and (contactCandleComplete or sameChildExactRecross) and not destinationBeforeContact and (exactFirstRecross or historicalRecross)
    if flipTriggered
        bool epochAdvanced = not na(lastTickEpoch) and epochSeconds(timenow) > lastTickEpoch
        bool triggerExact = exactFirstRecross and epochAdvanced and not coverageGapDetected
        if contextMinutes == 15
            attempt.htf15.htf15TriggeredThisTick := true
            attempt.htf15.htf15TriggerExact := triggerExact
        else if contextMinutes == 30
            attempt.htf30.htf30TriggeredThisTick := true
            attempt.htf30.htf30TriggerExact := triggerExact
        else
            attempt.htf60.htf60TriggeredThisTick := true
            attempt.htf60.htf60TriggerExact := triggerExact
    if barstate.isrealtime and activeContext and not flipTriggered
        bool coverageGap = not na(lastTickSequence) and lastTickSequence + 1 != tickSequence
        if coverageGap
            coverageGapDetected := true
            coverageReady := false
            coverageStartEpoch := epochSeconds(timenow)
        if na(coverageStartEpoch)
            coverageStartEpoch := epochSeconds(timenow)
        previousAtOrInsideOpen := currentAtOrInsideOpen
        lastTickSequence := tickSequence
        lastTickEpoch := epochSeconds(timenow)
        previousTickTicks := priceTicks(close)
        coverageReady := true
        if contextMinutes == 15
            attempt.htf15.htf15CoverageReady := coverageReady
            attempt.htf15.htf15PreviousAtOrInsideOpen := previousAtOrInsideOpen
            attempt.htf15.htf15LastTickSequence := lastTickSequence
            attempt.htf15.htf15LastTickEpoch := lastTickEpoch
            attempt.htf15.htf15PreviousTickTicks := previousTickTicks
            attempt.htf15.htf15CoverageStartEpoch := coverageStartEpoch
            attempt.htf15.htf15CoverageGapDetected := coverageGapDetected
        else if contextMinutes == 30
            attempt.htf30.htf30CoverageReady := coverageReady
            attempt.htf30.htf30PreviousAtOrInsideOpen := previousAtOrInsideOpen
            attempt.htf30.htf30LastTickSequence := lastTickSequence
            attempt.htf30.htf30LastTickEpoch := lastTickEpoch
            attempt.htf30.htf30PreviousTickTicks := previousTickTicks
            attempt.htf30.htf30CoverageStartEpoch := coverageStartEpoch
            attempt.htf30.htf30CoverageGapDetected := coverageGapDetected
        else
            attempt.htf60.htf60CoverageReady := coverageReady
            attempt.htf60.htf60PreviousAtOrInsideOpen := previousAtOrInsideOpen
            attempt.htf60.htf60LastTickSequence := lastTickSequence
            attempt.htf60.htf60LastTickEpoch := lastTickEpoch
            attempt.htf60.htf60PreviousTickTicks := previousTickTicks
            attempt.htf60.htf60CoverageStartEpoch := coverageStartEpoch
            attempt.htf60.htf60CoverageGapDetected := coverageGapDetected
    flipTriggered

finalizeFlipCandidate(EntryAttempt attempt) =>
    int nowEpoch = entryClockEpoch()
    bool triggered = false
    if attempt.flip.flipAuditPending and nowEpoch > attempt.flip.flipEventEpoch
        attempt.flip.flipAuditPending := false
        attempt.flip.flipCoverageEndEpoch := nowEpoch
        attempt.flip.flipObservedAtEpoch := nowEpoch
        triggered := true
    int mask = (attempt.htf15.htf15TriggeredThisTick ? 1 : 0) + (attempt.htf30.htf30TriggeredThisTick ? 2 : 0) + (attempt.htf60.htf60TriggeredThisTick ? 4 : 0)
    bool newObservation = not attempt.flip.flipEmitted and mask > 0
    if newObservation
        int firstContext = attempt.htf15.htf15TriggeredThisTick ? 15 : attempt.htf30.htf30TriggeredThisTick ? 30 : 60
        int anchorEpoch = firstContext == 15 ? attempt.htf15.htf15AnchorEpoch : firstContext == 30 ? attempt.htf30.htf30AnchorEpoch : attempt.htf60.htf60AnchorEpoch
        int openTicks = firstContext == 15 ? attempt.htf15.htf15OpenTicks : firstContext == 30 ? attempt.htf30.htf30OpenTicks : attempt.htf60.htf60OpenTicks
        int contactOpenEpoch = firstContext == 15 ? attempt.htf15.htf15ContactOpenEpoch : firstContext == 30 ? attempt.htf30.htf30ContactOpenEpoch : attempt.htf60.htf60ContactOpenEpoch
        int contactCloseEpoch = firstContext == 15 ? attempt.htf15.htf15ContactCloseEpoch : firstContext == 30 ? attempt.htf30.htf30ContactCloseEpoch : attempt.htf60.htf60ContactCloseEpoch
        int contactOpenTicks = firstContext == 15 ? attempt.htf15.htf15ContactOpenTicks : firstContext == 30 ? attempt.htf30.htf30ContactOpenTicks : attempt.htf60.htf60ContactOpenTicks
        int contactHighTicks = firstContext == 15 ? attempt.htf15.htf15ContactHighTicks : firstContext == 30 ? attempt.htf30.htf30ContactHighTicks : attempt.htf60.htf60ContactHighTicks
        int contactLowTicks = firstContext == 15 ? attempt.htf15.htf15ContactLowTicks : firstContext == 30 ? attempt.htf30.htf30ContactLowTicks : attempt.htf60.htf60ContactLowTicks
        int contactCloseTicks = firstContext == 15 ? attempt.htf15.htf15ContactCloseTicks : firstContext == 30 ? attempt.htf30.htf30ContactCloseTicks : attempt.htf60.htf60ContactCloseTicks
        int coverageStartEpoch = firstContext == 15 ? attempt.htf15.htf15CoverageStartEpoch : firstContext == 30 ? attempt.htf30.htf30CoverageStartEpoch : attempt.htf60.htf60CoverageStartEpoch
        int previousTickEpoch = firstContext == 15 ? attempt.htf15.htf15LastTickEpoch : firstContext == 30 ? attempt.htf30.htf30LastTickEpoch : attempt.htf60.htf60LastTickEpoch
        int previousTickTicks = firstContext == 15 ? attempt.htf15.htf15PreviousTickTicks : firstContext == 30 ? attempt.htf30.htf30PreviousTickTicks : attempt.htf60.htf60PreviousTickTicks
        bool exact = firstContext == 15 ? attempt.htf15.htf15TriggerExact : firstContext == 30 ? attempt.htf30.htf30TriggerExact : attempt.htf60.htf60TriggerExact
        bool compatible15 = not attempt.htf15.htf15TriggeredThisTick or attempt.htf15.htf15AnchorEpoch == anchorEpoch and attempt.htf15.htf15OpenTicks == openTicks and attempt.htf15.htf15ContactOpenEpoch == contactOpenEpoch and attempt.htf15.htf15ContactCloseEpoch == contactCloseEpoch and attempt.htf15.htf15ContactOpenTicks == contactOpenTicks and attempt.htf15.htf15ContactHighTicks == contactHighTicks and attempt.htf15.htf15ContactLowTicks == contactLowTicks and attempt.htf15.htf15ContactCloseTicks == contactCloseTicks and attempt.htf15.htf15CoverageStartEpoch == coverageStartEpoch and attempt.htf15.htf15LastTickEpoch == previousTickEpoch and attempt.htf15.htf15PreviousTickTicks == previousTickTicks
        bool compatible30 = not attempt.htf30.htf30TriggeredThisTick or attempt.htf30.htf30AnchorEpoch == anchorEpoch and attempt.htf30.htf30OpenTicks == openTicks and attempt.htf30.htf30ContactOpenEpoch == contactOpenEpoch and attempt.htf30.htf30ContactCloseEpoch == contactCloseEpoch and attempt.htf30.htf30ContactOpenTicks == contactOpenTicks and attempt.htf30.htf30ContactHighTicks == contactHighTicks and attempt.htf30.htf30ContactLowTicks == contactLowTicks and attempt.htf30.htf30ContactCloseTicks == contactCloseTicks and attempt.htf30.htf30CoverageStartEpoch == coverageStartEpoch and attempt.htf30.htf30LastTickEpoch == previousTickEpoch and attempt.htf30.htf30PreviousTickTicks == previousTickTicks
        bool compatible60 = not attempt.htf60.htf60TriggeredThisTick or attempt.htf60.htf60AnchorEpoch == anchorEpoch and attempt.htf60.htf60OpenTicks == openTicks and attempt.htf60.htf60ContactOpenEpoch == contactOpenEpoch and attempt.htf60.htf60ContactCloseEpoch == contactCloseEpoch and attempt.htf60.htf60ContactOpenTicks == contactOpenTicks and attempt.htf60.htf60ContactHighTicks == contactHighTicks and attempt.htf60.htf60ContactLowTicks == contactLowTicks and attempt.htf60.htf60ContactCloseTicks == contactCloseTicks and attempt.htf60.htf60CoverageStartEpoch == coverageStartEpoch and attempt.htf60.htf60LastTickEpoch == previousTickEpoch and attempt.htf60.htf60PreviousTickTicks == previousTickTicks
        bool compatible = compatible15 and compatible30 and compatible60
        bool allExact = (not attempt.htf15.htf15TriggeredThisTick or attempt.htf15.htf15TriggerExact) and (not attempt.htf30.htf30TriggeredThisTick or attempt.htf30.htf30TriggerExact) and (not attempt.htf60.htf60TriggeredThisTick or attempt.htf60.htf60TriggerExact)
        bool selectedCoverageGap = (attempt.htf15.htf15TriggeredThisTick and attempt.htf15.htf15CoverageGapDetected) or (attempt.htf30.htf30TriggeredThisTick and attempt.htf30.htf30CoverageGapDetected) or (attempt.htf60.htf60TriggeredThisTick and attempt.htf60.htf60CoverageGapDetected)
        attempt.flip.flipEmitted := true
        attempt.flip.flipEventEpoch := nowEpoch
        attempt.flip.flipEventSequence := tickSequence
        attempt.flip.flipEventTicks := priceTicks(close)
        attempt.flip.flipContextMinutes := firstContext
        attempt.flip.flipContextMask := mask
        attempt.flip.flipAnchorEpoch := anchorEpoch
        attempt.flip.flipOpenTicks := openTicks
        bool triggerCausal = barstate.isrealtime ? not na(previousTickEpoch) and nowEpoch > previousTickEpoch : nowEpoch > coverageStartEpoch
        int recrossOpenEpoch = barstate.isrealtime ? previousTickEpoch : epochSeconds(time)
        bool lifecycleCausal = triggerCausal and not na(contactOpenEpoch) and not na(contactCloseEpoch) and not na(recrossOpenEpoch) and contactOpenEpoch < contactCloseEpoch and contactCloseEpoch <= recrossOpenEpoch and recrossOpenEpoch < nowEpoch
        attempt.flip.flipTriggerCausal := triggerCausal
        attempt.flip.flipLifecycleCausal := lifecycleCausal
        attempt.flip.flipAuditPending := not triggerCausal
        attempt.flip.flipFidelity := compatible and exact and allExact and triggerCausal and lifecycleCausal ? "EXACT" : "UNRESOLVED"
        attempt.flip.flipProofPlane := barstate.isrealtime ? ENTRY_REALTIME_PLANE : ENTRY_CONFIRMED_PLANE
        attempt.flip.flipReplayability := barstate.isrealtime ? ENTRY_LIVE_REPLAYABILITY : ENTRY_REPLAYABLE
        attempt.flip.flipCoverageStartEpoch := coverageStartEpoch
        attempt.flip.flipCoverageEndEpoch := triggerCausal ? nowEpoch : na
        attempt.flip.flipObservedAtEpoch := triggerCausal ? nowEpoch : na
        attempt.flip.flipCoverageGapDetected := selectedCoverageGap
        attempt.flip.flipFullLifecycleOrdered := lifecycleCausal
        attempt.flip.flipAmbiguityCode := not triggerCausal or selectedCoverageGap ? "SHADOW_MISSING_INTRABAR_COVERAGE" : not barstate.isrealtime ? "SHADOW_SAME_CHILD_BAR_ORDER" : "SHADOW_REALTIME_ONLY_NOT_REPLAYABLE"
        attempt.flip.flipFailureCode := not triggerCausal ? "HTF_FLIP_CAUSAL_EPOCH_UNREPRESENTABLE" : not compatible ? "HTF_FLIP_INCOMPATIBLE_CONTEXTS" : selectedCoverageGap ? "HTF_FLIP_MISSING_INTRABAR_COVERAGE" : not barstate.isrealtime ? "HISTORICAL_ORDER_UNPROVEN" : "HTF_FLIP_LIFECYCLE_UNRESOLVED"
        attempt.flip.flipContactOpenEpoch := contactOpenEpoch
        attempt.flip.flipContactCloseEpoch := contactCloseEpoch
        attempt.flip.flipContactOpenTicks := contactOpenTicks
        attempt.flip.flipContactHighTicks := contactHighTicks
        attempt.flip.flipContactLowTicks := contactLowTicks
        attempt.flip.flipContactCloseTicks := contactCloseTicks
        attempt.flip.flipRecrossOpenEpoch := recrossOpenEpoch
        attempt.flip.flipRecrossCloseEpoch := attempt.flip.flipEventEpoch
        attempt.flip.flipRecrossOpenTicks := barstate.isrealtime ? previousTickTicks : priceTicks(open)
        attempt.flip.flipRecrossHighTicks := barstate.isrealtime ? math.max(previousTickTicks, priceTicks(close)) : priceTicks(high)
        attempt.flip.flipRecrossLowTicks := barstate.isrealtime ? math.min(previousTickTicks, priceTicks(close)) : priceTicks(low)
        attempt.flip.flipRecrossCloseTicks := priceTicks(close)
        if na(attempt.core.entryTicks)
            attempt.core.entryTicks := attempt.flip.flipEventTicks
        triggered := not attempt.flip.flipAuditPending
    triggered

monitorAttemptExit(EntryAttempt attempt, RawZone zone) =>
    bool emitted = false
    if not na(attempt.core.entryTicks) and not attempt.core.exitTerminal and entryBundleReadyToEmit(attempt)
        int stopPriceTicks = not na(attempt.core.stopTicks) ? attempt.core.stopTicks : attempt.core.demand ? attempt.core.entryTicks - entryStopTicks : attempt.core.entryTicks + entryStopTicks
        int targetPriceTicks = not na(attempt.core.targetTicks) ? attempt.core.targetTicks : attempt.core.demand ? attempt.core.entryTicks + entryTargetTicks : attempt.core.entryTicks - entryTargetTicks
        float stopPrice = stopPriceTicks * syminfo.mintick
        float targetPrice = targetPriceTicks * syminfo.mintick
        bool stopHit = attempt.core.demand ? (barstate.isrealtime ? close <= stopPrice : low <= stopPrice) : (barstate.isrealtime ? close >= stopPrice : high >= stopPrice)
        bool targetHit = attempt.core.demand ? (barstate.isrealtime ? close >= targetPrice : high >= targetPrice) : (barstate.isrealtime ? close <= targetPrice : low <= targetPrice)
        bool historicalAmbiguous = not barstate.isrealtime and stopHit and targetHit
        bool newStop = stopHit and not targetHit and not attempt.core.stopEventEmitted and not attempt.core.targetEventEmitted
        bool newTarget = targetHit and not stopHit and not attempt.core.stopEventEmitted and not attempt.core.targetEventEmitted
        if historicalAmbiguous or newStop or newTarget
            string reason = historicalAmbiguous ? "AMBIGUOUS_SAME_BAR_EXIT" : newStop ? "STOP_LOSS" : "TARGET"
            int eventTicks = historicalAmbiguous ? priceTicks(close) : newStop ? stopPriceTicks : targetPriceTicks
            string eventId = attempt.core.setupId + ":exit:" + reason + ":" + str.tostring(tickSequence)
            string exitEvent = "[{\"event_id\":" + jsonString(eventId) + ",\"setup_id\":" + jsonString(attempt.core.setupId) + ",\"exit_reason\":" + jsonString(reason) + ",\"epoch\":" + str.tostring(barstate.isrealtime ? epochSeconds(timenow) : epochSeconds(time_close)) + ",\"sequence\":" + str.tostring(tickSequence) + ",\"price_ticks\":" + str.tostring(eventTicks) + "}]"
            attempt.core.stopEventEmitted := newStop
            attempt.core.targetEventEmitted := newTarget
            attempt.core.ambiguousExitEmitted := historicalAmbiguous
            attempt.core.exitTerminal := true
            emitted := emitEntryPayload(attempt, zone, barstate.isrealtime, exitEvent, historicalAmbiguous)
    emitted

deleteZone(RawZone zone) =>
    if not na(zone.zoneBox)
        box.delete(zone.zoneBox)
    if not na(zone.liquidityLine)
        line.delete(zone.liquidityLine)
    if not na(zone.ownExtremeLine)
        line.delete(zone.ownExtremeLine)
    if not na(zone.debugLabel)
        label.delete(zone.debugLabel)

var Candidate demandCandidate = Candidate.new()
var Candidate supplyCandidate = Candidate.new()
var RawZone[] zones = array.new<RawZone>()
var LiquidityLevel[] liquidityLevels = array.new<LiquidityLevel>()
var int[] createdLiquidityIndexes = array.new<int>()
var int[] drawnLiquidityIndexes = array.new<int>()
var int nextZoneId = 1
var string lastDecision = "WAITING_FOR_CLOSED_5M_BAR"
var int validationSequence = 0
var bool validationStarted = not validationCapture or validationCalculationStart == 0
var bool validationFailed = false
var string validationFailureReason = ""

zoneHasActiveAttempt(int zoneId) =>
    bool protectedAttempt = false
    int attemptIndex = entryAttemptIndex(zoneId)
    if not na(attemptIndex)
        EntryAttempt attempt = array.get(entryAttempts, attemptIndex)
        protectedAttempt := not attempt.core.exitTerminal
    protectedAttempt

evictOldestUnprotectedZone(array<RawZone> zoneItems, array<EntryAttempt> attempts) =>
    bool removed = false
    int scanIndex = array.size(zoneItems) - 1
    while scanIndex >= 0 and not removed
        RawZone oldest = array.get(zoneItems, scanIndex)
        if not zoneHasActiveAttempt(oldest.id)
            int attemptIndex = entryAttemptIndex(oldest.id)
            if not na(attemptIndex)
                array.remove(attempts, attemptIndex)
            array.remove(zoneItems, scanIndex)
            deleteZone(oldest)
            removed := true
        scanIndex -= 1
    removed

if barstate.isfirst
    demandCandidate.reset()
    supplyCandidate.reset()
    array.clear(entryAttempts)

if barstate.isrealtime
    tickSequence += 1

bool isFiveMinute = timeframe.isminutes and timeframe.multiplier == 5
bool confirmedEvent = false
RawZone eventZone = na
string validationEvents = ""

if barstate.isconfirmed and isFiveMinute and validationCapture and not validationStarted and not validationFailed
    if time == validationCalculationStart
        demandCandidate.reset()
        supplyCandidate.reset()
        array.clear(zones)
        array.clear(liquidityLevels)
        array.clear(createdLiquidityIndexes)
        array.clear(drawnLiquidityIndexes)
        array.clear(entryAttempts)
        nextZoneId := 1
        validationSequence := 0
        validationStarted := true
    else if time > validationCalculationStart
        validationFailed := true
        validationFailureReason := "CALCULATION_START_BAR_MISSING"
        string missingStart = validationBatch(validationFailure("RUN_FAILED_MISSING_HISTORY", validationFailureReason), validationSequence)
        log.error(missingStart)

bool validationReady = not validationCapture or (validationStarted and not validationFailed)

if barstate.isconfirmed and isFiveMinute and validationReady
    validationEvents := validationHeartbeat()
    int validationEventCount = 1
    array<string> setupExportItems = array.new<string>()
    array<string> setupSnapshotItemsAtBarStart = array.new<string>()
    bool setupExportReady = exportSetupEvents and str.length(setupExportCredential) > 0 and barstate.isrealtime
    if setupExportReady and setupExportSnapshotPending
        collectCanonicalSetupSnapshot(zones, setupSnapshotItemsAtBarStart)
    if exportSetupEvents
        clearSetupExportTransitionBuffers(zones)
    bool inEmissionWindow = (validationEmissionStart == 0 or time >= validationEmissionStart) and (validationEmissionEnd == 0 or time <= validationEmissionEnd)
    bool emissionStartsNow = validationCapture and inEmissionWindow and (validationEmissionStart == 0 ? validationSequence == 0 : time == validationEmissionStart)
    bool emissionEndsNow = validationCapture and validationEmissionEnd != 0 and time == validationEmissionEnd
    if emissionStartsNow
        validationEvents := appendValidationEvent(validationEvents, validationSentinel("CAPTURE_START"))
        validationEventCount += 1
    updateConfirmedLiquidityPivots(liquidityLevels, createdLiquidityIndexes)

    int zoneCount = array.size(zones)
    if zoneCount > 0
        // Liquidity must be refreshed while the zone is still fresh. This preserves
        // same-bar sweep/engagement evidence so it can fail closed as SHADOW_ONLY.
        for index = 0 to zoneCount - 1
            RawZone zone = array.get(zones, index)
            [primaryAvailable, primaryTaken, primarySwept, primaryChanged] = refreshZoneLiquidity(zone, liquidityLevels, createdLiquidityIndexes)
            bool becameEligible = updateZoneEligibility(zone, primaryAvailable, primaryTaken, primarySwept, primaryChanged)
            if becameEligible
                lastDecision := LIQUIDITY_SEQUENCE_QUALIFIED
                if emitDiagnostics or validationCapture
                    validationEvents := appendValidationEvent(validationEvents, diagnosticPayload("ZONE_ELIGIBLE_NON_EXECUTABLE", zone))
                    validationEventCount += 1
            array.set(zones, index, zone)

        for index = 0 to zoneCount - 1
            RawZone zone = array.get(zones, index)
            if zone.state == STATE_FRESH and bar_index > zone.confirmationBar
                bool sameDirectionDeparture = zone.demand ? close > open : close < open
                if not (zone.departureActive and sameDirectionDeparture)
                    zone.departureActive := false
                    bool reachedOrCrossed = zoneReachedOrCrossed(zone)
                    if reachedOrCrossed
                        bool invalidated = zoneCloseInvalidBeforeEntry(zone)
                        zone.state := invalidated ? STATE_INVALIDATED : STATE_TAPPED
                        zone.stateBar := bar_index
                        zone.stateTime := time_close
                        zone.reason := invalidated ? INVALIDATE_PRE_ENTRY_CLOSE_INSIDE_OR_THROUGH : TAP_POST_CONFIRM_OVERLAP
                        lastDecision := zone.reason
                        if emitDiagnostics or validationCapture
                            validationEvents := appendValidationEvent(validationEvents, diagnosticPayload(invalidated ? "ZONE_INVALIDATED_NON_EXECUTABLE" : "ZONE_TAPPED_NON_EXECUTABLE", zone))
                            validationEventCount += 1
            bool setupTerminal = zone.setupState == SETUP_SHADOW_ONLY or zone.setupState == SETUP_REJECTED
            bool reactionStillWaiting = zone.state == STATE_TAPPED and not setupTerminal and bar_index > zone.stateBar
            if reactionStillWaiting and zoneReachedOrCrossed(zone) and zoneCloseInvalidBeforeEntry(zone)
                zone.state := STATE_INVALIDATED
                zone.stateBar := bar_index
                zone.stateTime := time_close
                zone.reason := INVALIDATE_PRE_ENTRY_CLOSE_INSIDE_OR_THROUGH
                lastDecision := zone.reason
                if emitDiagnostics or validationCapture
                    validationEvents := appendValidationEvent(validationEvents, diagnosticPayload("ZONE_INVALIDATED_NON_EXECUTABLE", zone))
                    validationEventCount += 1
            array.set(zones, index, zone)

        for index = 0 to zoneCount - 1
            RawZone zone = array.get(zones, index)
            int blockerId = routeBlockerId(zone, zones)
            if not na(blockerId)
                zone.eligibilityState := ELIGIBILITY_EXPIRED
                zone.eligibilityBar := bar_index
                zone.eligibilityTime := time_close
                zone.eligibilityReason := EXPIRE_OPPOSITE_ZONE_RETRACE
                zone.routeBlockerId := blockerId
                lastDecision := EXPIRE_OPPOSITE_ZONE_RETRACE
                if emitDiagnostics or validationCapture
                    validationEvents := appendValidationEvent(validationEvents, diagnosticPayload("ZONE_ROUTE_EXPIRED_NON_EXECUTABLE", zone))
                    validationEventCount += 1
            array.set(zones, index, zone)

        for index = 0 to zoneCount - 1
            RawZone zone = array.get(zones, index)
            string setupEvent = updateSetupState(zone, zones)
            if str.length(setupEvent) > 0
                lastDecision := zone.setupReason
                if emitDiagnostics or validationCapture
                    validationEvents := appendValidationEvent(validationEvents, diagnosticPayload(setupEvent, zone))
                    validationEventCount += 1
            if exportSetupEvents
                syncSetupExportLifecycle(zone)
            array.set(zones, index, zone)

    // Materialize attempts immediately after engagement/setup transitions so a
    // same-update tapped+armed zone is protected before bounded retention.
    materializeEngagedEntryAttempts(zones)

    int direction = candleDirection(0)
    if direction == 1
        if demandCandidate.isActive
            bool confirmed = demandCandidate.advance(true)
            if confirmed
                string formation = candidateFormation(demandCandidate, true)
                if str.length(formation) == 0
                    lastDecision := REJECT_UNKNOWN_APPROACH
                else
                    RawZone zone = buildConfirmedZone(demandCandidate, true, nextZoneId, formation)
                    array.unshift(zones, zone)
                    nextZoneId += 1
                    confirmedEvent := true
                    eventZone := zone
                    lastDecision := CONFIRM_CLOSE_BEYOND_ORIGIN
                demandCandidate.reset()
        bool rebasedSupply = supplyCandidate.rebaseInsideFormation(false)
        if not rebasedSupply
            if supplyCandidate.isActive and supplyCandidate.isForming
                lastDecision := REJECT_FORMATION_INTERRUPTED
            supplyCandidate.reset()
            supplyCandidate.begin()
    else if direction == -1
        if supplyCandidate.isActive
            bool confirmed = supplyCandidate.advance(false)
            if confirmed
                string formation = candidateFormation(supplyCandidate, false)
                if str.length(formation) == 0
                    lastDecision := REJECT_UNKNOWN_APPROACH
                else
                    RawZone zone = buildConfirmedZone(supplyCandidate, false, nextZoneId, formation)
                    array.unshift(zones, zone)
                    nextZoneId += 1
                    confirmedEvent := true
                    eventZone := zone
                    lastDecision := CONFIRM_CLOSE_BEYOND_ORIGIN
                supplyCandidate.reset()
        bool rebasedDemand = demandCandidate.rebaseInsideFormation(true)
        if not rebasedDemand
            if demandCandidate.isActive and demandCandidate.isForming
                lastDecision := REJECT_FORMATION_INTERRUPTED
            demandCandidate.reset()
            demandCandidate.begin()
    else
        if demandCandidate.isActive and demandCandidate.isForming
            lastDecision := REJECT_FORMATION_INTERRUPTED
        if supplyCandidate.isActive and supplyCandidate.isForming
            lastDecision := REJECT_FORMATION_INTERRUPTED
        demandCandidate.reset()
        supplyCandidate.reset()

    // Capture finalized same-bar transitions before bounded retention can remove an old terminal zone.
    if setupExportReady
        collectCanonicalSetupTransitions(zones, setupExportItems)
    int replacementZoneCount = array.size(zones)
    if replacementZoneCount > 0
        for replacementZoneIndex = 0 to replacementZoneCount - 1
            RawZone replacementZone = array.get(zones, replacementZoneIndex)
            applyPendingLiquidityReplacement(replacementZone)
            array.set(zones, replacementZoneIndex, replacementZone)

    entryRetentionBlocked := false
    while array.size(zones) > maxZones
        bool evicted = evictOldestUnprotectedZone(zones, entryAttempts)
        if not evicted
            entryRetentionBlocked := true
            log.warning("ENTRY_VISUAL_RETENTION_BLOCKED_BY_ACTIVE_ATTEMPTS")
            break
    if array.size(entryAttempts) > ENTRY_MAX_ATTEMPTS
        runtime.error("ENTRY_ATTEMPT_HARD_CAP_INVARIANT")

    if setupExportReady
        if setupExportSnapshotPending
            bool snapshotEmitted = emitSetupExportSnapshot(setupSnapshotItemsAtBarStart)
            if snapshotEmitted
                setupExportSnapshotPending := false
                setupExportBatchSequence := 1
                if array.size(setupExportItems) > 0
                    emitSetupExportIncremental(setupExportItems, setupExportBatchSequence)
                    setupExportBatchSequence += 1
        else
            // A confirmed-bar envelope is also the delivery heartbeat. Empty
            // transition arrays prove the alert path is still alive.
            emitSetupExportIncremental(setupExportItems, setupExportBatchSequence)
            setupExportBatchSequence += 1

    if confirmedEvent and (emitDiagnostics or validationCapture) and not na(eventZone)
        validationEvents := appendValidationEvent(validationEvents, diagnosticPayload("ZONE_CONFIRMED_NON_EXECUTABLE", eventZone))
        validationEventCount += 1

    if emissionEndsNow
        validationEvents := appendValidationEvent(validationEvents, validationSentinel("CAPTURE_END"))
        validationEventCount += 1

    if emitDiagnostics or validationCapture
        if validationEventCount > VALIDATION_MAX_BATCH_EVENTS
            validationFailed := true
            validationFailureReason := "BATCH_EVENT_LIMIT_EXCEEDED"
            validationEvents := validationFailure("RUN_FAILED_OVERFLOW", validationFailureReason)
        string batchPayload = validationBatch(validationEvents, validationSequence)
        if str.length(batchPayload) > VALIDATION_MAX_PAYLOAD_CHARS
            validationFailed := true
            validationFailureReason := "BATCH_PAYLOAD_TOO_LARGE"
            log.error(validationBatch(validationFailure("RUN_FAILED_OVERFLOW", validationFailureReason), validationSequence))
        else
            if validationCapture and inEmissionWindow
                log.info(batchPayload)
            if emitDiagnostics
                log.info(batchPayload)
        validationSequence += 1

    if validationCapture and validationFailed
        int failedZoneCount = array.size(zones)
        if failedZoneCount > 0
            for failedIndex = 0 to failedZoneCount - 1
                deleteZone(array.get(zones, failedIndex))
        array.clear(zones)
        array.clear(liquidityLevels)

// Entry candidates are evaluated after the qualified setup engine has completed
// its update. This block also runs on realtime intrabar updates, which is what
// preserves first-crossing chronology for BOC and flip.
int entryZoneCount = array.size(zones)
if isFiveMinute and validationReady and entryZoneCount > 0
    for entryZoneIndex = 0 to entryZoneCount - 1
        RawZone zone = array.get(zones, entryZoneIndex)
        int attemptIndex = ensureEntryAttempt(zone)
        if not na(attemptIndex)
            EntryAttempt attempt = array.get(entryAttempts, attemptIndex)
            bool candidateObservationOpen = not attempt.core.invalidatedBeforeEntry and zone.state != STATE_INVALIDATED and zone.setupState == SETUP_ARMED
            bool bocTriggered = false
            bool flipTriggered = false
            bool closeTriggered = false
            bocTriggered := recordBoc(attempt, zone, candidateObservationOpen)
            if candidateObservationOpen
                bool flip15Triggered = updateFlipContext(attempt, zone, 15)
                bool flip30Triggered = updateFlipContext(attempt, zone, 30)
                bool flip60Triggered = updateFlipContext(attempt, zone, 60)
                closeTriggered := recordDirectionalClose(attempt, zone)
            flipTriggered := finalizeFlipCandidate(attempt)
            bool candidateChanged = bocTriggered or flipTriggered or closeTriggered
            bool bundleReady = entryBundleReadyToEmit(attempt)
            if candidateChanged and bundleReady
                if not attempt.core.paperDecisionEmitted and entryHasPaperEligibleSelection(attempt)
                    [selectedEpoch, selectedSequence, selectedTicks] = entrySelectedFacts(attempt)
                    attempt.core.paperDecisionEmitted := true
                    attempt.core.entryTicks := selectedTicks
                    attempt.core.stopTicks := zone.demand ? selectedTicks - entryStopTicks : selectedTicks + entryStopTicks
                    attempt.core.targetTicks := zone.demand ? selectedTicks + entryTargetTicks : selectedTicks - entryTargetTicks
                bool intrabarCandidate = barstate.isrealtime and not closeTriggered
                emitEntryPayload(attempt, zone, intrabarCandidate, "[]", false)
            if bundleReady
                monitorAttemptExit(attempt, zone)
            array.set(entryAttempts, attemptIndex, attempt)

int drawCount = array.size(zones)
if drawCount > 0
    for index = 0 to drawCount - 1
        RawZone zone = array.get(zones, index)
        updateZoneDrawing(zone, zones)
        array.set(zones, index, zone)
updateLiquidityDrawings(liquidityLevels, drawnLiquidityIndexes, zones)

var table statusTable = table.new(position.top_right, 1, 2, border_width = 0)
if barstate.islast
    if showStatusPanel
        table.cell(statusTable, 0, 0, isFiveMinute ? "SND RD | " + str.upper(displayMode) : "5m chart required", text_color = color.white, bgcolor = isFiveMinute ? color.new(color.black, 58) : color.new(color.red, 25), text_size = size.small)
        table.cell(statusTable, 0, 1, premiumVisuals ? "" : lastDecision, text_color = color.white, bgcolor = premiumVisuals ? color.new(color.black, 100) : color.new(color.black, 28), text_size = size.tiny)
    else
        table.cell(statusTable, 0, 0, "", bgcolor = color.new(color.black, 100))
        table.cell(statusTable, 0, 1, "", bgcolor = color.new(color.black, 100))
