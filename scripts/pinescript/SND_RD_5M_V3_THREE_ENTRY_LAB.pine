    attempt.htf30.htf30ContactTickEpoch := na
    attempt.htf30.htf30ContactTickSequence := na
    attempt.htf30.htf30CoverageReady := false
    attempt.htf30.htf30PreviousAtOrInsideOpen := false
    attempt.htf30.htf30LastTickSequence := na
    attempt.htf30.htf30LastTickEpoch := na
    attempt.htf30.htf30PreviousTickTicks := na
    attempt.htf30.htf30CoverageStartEpoch := na
    attempt.htf30.htf30CoverageGapDetected := false
