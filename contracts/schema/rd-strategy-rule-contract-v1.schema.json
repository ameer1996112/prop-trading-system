{
  "$defs": {
    "RDDistanceGuidance": {
      "additionalProperties": false,
      "properties": {
        "automation": {
          "const": "SHADOW_ONLY",
          "title": "Automation",
          "type": "string"
        },
        "confirmed_timeframe_minutes": {
          "const": 5,
          "title": "Confirmed Timeframe Minutes",
          "type": "integer"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/RDStrategyEvidenceRef"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "fidelity": {
          "enum": [
            "CALIBRATED",
            "DISCRETIONARY",
            "UNRESOLVED"
          ],
          "title": "Fidelity",
          "type": "string"
        },
        "guidance_max": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Guidance Max"
        },
        "guidance_min": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Guidance Min"
        },
        "profile_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@|+/-]+$",
          "title": "Profile Id",
          "type": "string"
        },
        "summary": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "symbol_patterns": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:@|+/-]+$",
            "type": "string"
          },
          "maxItems": 24,
          "minItems": 1,
          "title": "Symbol Patterns",
          "type": "array"
        },
        "unit": {
          "enum": [
            "PIP",
            "VISUAL_CONTEXT"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "symbol_patterns",
        "confirmed_timeframe_minutes",
        "unit",
        "guidance_min",
        "guidance_max",
        "fidelity",
        "automation",
        "summary",
        "evidence"
      ],
      "title": "RDDistanceGuidance",
      "type": "object"
    },
    "RDStrategyAutomationPolicy": {
      "additionalProperties": false,
      "properties": {
        "ambiguous_same_bar_order_action": {
          "const": "SHADOW_ONLY",
          "title": "Ambiguous Same Bar Order Action",
          "type": "string"
        },
        "disabled_entry_models": {
          "items": {
            "const": "BREAK_CANDLE",
            "type": "string"
          },
          "title": "Disabled Entry Models",
          "type": "array"
        },
        "executable_entry_models": {
          "items": {
            "const": "DIR_CLOSE",
            "type": "string"
          },
          "title": "Executable Entry Models",
          "type": "array"
        },
        "first_touch_action": {
          "const": "WAIT",
          "title": "First Touch Action",
          "type": "string"
        },
        "paper_only": {
          "const": true,
          "title": "Paper Only",
          "type": "boolean"
        },
        "real_execution_allowed": {
          "const": false,
          "title": "Real Execution Allowed",
          "type": "boolean"
        },
        "required_decision_fidelity": {
          "const": "EXACT",
          "title": "Required Decision Fidelity",
          "type": "string"
        },
        "shadow_entry_models": {
          "items": {
            "const": "HTF_FLIP",
            "type": "string"
          },
          "title": "Shadow Entry Models",
          "type": "array"
        },
        "unknown_rule_action": {
          "const": "SHADOW_ONLY",
          "title": "Unknown Rule Action",
          "type": "string"
        }
      },
      "required": [
        "paper_only",
        "real_execution_allowed",
        "first_touch_action",
        "unknown_rule_action",
        "ambiguous_same_bar_order_action",
        "required_decision_fidelity",
        "executable_entry_models",
        "shadow_entry_models",
        "disabled_entry_models"
      ],
      "title": "RDStrategyAutomationPolicy",
      "type": "object"
    },
    "RDStrategyEvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@|+/-]+$",
          "title": "Source Id",
          "type": "string"
        },
        "timestamp_seconds": {
          "maximum": 86400,
          "minimum": 0,
          "title": "Timestamp Seconds",
          "type": "integer"
        }
      },
      "required": [
        "source_id",
        "timestamp_seconds"
      ],
      "title": "RDStrategyEvidenceRef",
      "type": "object"
    },
    "RDStrategyRule": {
      "additionalProperties": false,
      "properties": {
        "automation": {
          "$ref": "#/$defs/RuleAutomation"
        },
        "category": {
          "enum": [
            "ZONE",
            "LIQUIDITY",
            "ENTRY",
            "MANAGEMENT",
            "RISK",
            "TIMEFRAME"
          ],
          "title": "Category",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/RDStrategyEvidenceRef"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "fidelity": {
          "$ref": "#/$defs/RuleFidelity"
        },
        "open_requirement": {
          "title": "Open Requirement",
          "type": "boolean"
        },
        "rule_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@|+/-]+$",
          "title": "Rule Id",
          "type": "string"
        },
        "summary": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "unresolved_terms": {
          "items": {
            "type": "string"
          },
          "maxItems": 24,
          "title": "Unresolved Terms",
          "type": "array"
        }
      },
      "required": [
        "rule_id",
        "category",
        "fidelity",
        "automation",
        "open_requirement",
        "summary",
        "evidence"
      ],
      "title": "RDStrategyRule",
      "type": "object"
    },
    "RDStrategySource": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "enum": [
            "BASELINE",
            "LATEST_OVERRIDE",
            "COMPATIBLE_GAP_FILL",
            "HISTORICAL_ONLY"
          ],
          "title": "Authority",
          "type": "string"
        },
        "published_date": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "Published Date",
          "type": "string"
        },
        "source_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@|+/-]+$",
          "title": "Source Id",
          "type": "string"
        },
        "title": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "youtube_video_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@|+/-]+$",
          "title": "Youtube Video Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "youtube_video_id",
        "published_date",
        "authority",
        "title"
      ],
      "title": "RDStrategySource",
      "type": "object"
    },
    "RuleAutomation": {
      "enum": [
        "EXECUTE",
        "SHADOW_ONLY",
        "DISABLED",
        "RISK_LAYER"
      ],
      "title": "RuleAutomation",
      "type": "string"
    },
    "RuleFidelity": {
      "enum": [
        "EXACT",
        "CALIBRATED",
        "DISCRETIONARY",
        "UNRESOLVED"
      ],
      "title": "RuleFidelity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "automation_policy": {
      "$ref": "#/$defs/RDStrategyAutomationPolicy"
    },
    "confirmed_timeframe_minutes": {
      "const": 5,
      "title": "Confirmed Timeframe Minutes",
      "type": "integer"
    },
    "contract_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@|+/-]+$",
      "title": "Contract Id",
      "type": "string"
    },
    "contract_version": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Contract Version",
      "type": "string"
    },
    "distance_guidance": {
      "items": {
        "$ref": "#/$defs/RDDistanceGuidance"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Distance Guidance",
      "type": "array"
    },
    "producer_strategy_version": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-(?:paper|contract)[0-9]+$",
      "title": "Producer Strategy Version",
      "type": "string"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/RDStrategyRule"
      },
      "maxItems": 128,
      "minItems": 1,
      "title": "Rules",
      "type": "array"
    },
    "schema_id": {
      "const": "phase0.rd-strategy-rule-contract.v1",
      "title": "Schema Id",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/RDStrategySource"
      },
      "maxItems": 12,
      "minItems": 4,
      "title": "Sources",
      "type": "array"
    },
    "strategy_id": {
      "const": "rd_liquidity_sd_5m_v1",
      "title": "Strategy Id",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "contract_id",
    "contract_version",
    "strategy_id",
    "producer_strategy_version",
    "confirmed_timeframe_minutes",
    "sources",
    "rules",
    "distance_guidance",
    "automation_policy"
  ],
  "title": "RDStrategyRuleContract",
  "type": "object"
}
