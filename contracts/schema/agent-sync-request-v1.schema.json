              "$ref": "#/$defs/nonnegativeSafeInteger"
            },
            {
              "type": "null"
            }
          ]
        },
        "windows_time_epoch": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonnegativeSafeInteger"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
