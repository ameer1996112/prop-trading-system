        "setup_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@|+/-]+$",
          "title": "Setup Id",
          "type": "string"
        },
        "symbol": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@|+/-]+$",
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "setup_id",
        "symbol",
        "feed",
        "calculation_start_epoch",
        "emission_start_epoch",
