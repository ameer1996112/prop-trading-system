    "RDEntryCandidateVectorV2": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "direction": {
          "enum": [
            "LONG",
            "SHORT"
          ],
          "title": "Direction",
          "type": "string"
        },
        "event_anchor_epoch": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Event Anchor Epoch",
          "type": "integer"
        },
        "model": {
          "enum": [
            "DIR_CLOSE",
            "HTF_FLIP",
            "LEGACY_BREAK_CANDLE",
            "LEGACY_REJECTION_RESPECT"
          ],
          "title": "Model",
          "type": "string"
        },
        "normalized_from": {
          "anyOf": [
            {
              "enum": [
                "DIR_CLOSE",
                "HTF_FLIP",
                "LEGACY_BREAK_CANDLE",
                "LEGACY_REJECTION_RESPECT"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Normalized From"
        },
        "observed_at_epoch": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Observed At Epoch",
          "type": "integer"
        },
        "setup_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@|+/-]+$",
          "title": "Setup Id",
          "type": "string"
        },
        "source_claim_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:@|+/-]+$",
            "type": "string"
          },
          "title": "Source Claim Ids",
          "type": "array"
        },
        "state": {
          "enum": [
            "MATCHED",
            "BLOCKED",
            "REJECTED",
            "NORMALIZED"
          ],
          "title": "State",
          "type": "string"
        },
        "trigger_ordinal": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "title": "Trigger Ordinal",
          "type": "integer"
        }
      },
      "required": [
        "candidate_id",
        "setup_id",
        "model",
        "state",
        "event_anchor_epoch",
        "trigger_ordinal",
        "direction",
        "source_claim_ids",
        "normalized_from",
        "observed_at_epoch"
      ],
      "title": "RDEntryCandidateVectorV2",
      "type": "object"
    },
