          "title": "Feed",
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/RDEntryRawInputVectorV2"
        },
        "pine_edge_input": {
          "$ref": "#/$defs/RDEntryEdgeInputVectorV2"
        },
