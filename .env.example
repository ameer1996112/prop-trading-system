# Placeholders only. Keep raw credentials outside the repository.
PTS_APP_ENVIRONMENT=<local-or-test>
PTS_DATABASE_DSN=<postgresql-async-dsn>
PTS_PHASE0_EVIDENCE_PATH=<absolute-or-repository-relative-path>
PTS_TRADINGVIEW_OBSERVATION_INGRESS_ENABLED=false
PTS_TRADINGVIEW_OBSERVATION_CREDENTIAL_SHA256=<64-lowercase-hex-sha256>
PTS_TRADINGVIEW_OBSERVATION_MAX_BODY_BYTES=262144
PAPER_LEDGER_ENABLED=false
PAPER_LEDGER_ADMIN_CREDENTIAL_FILE=<absolute-path-outside-repository>
PAPER_LEDGER_ADMIN_CREDENTIAL_SHA256=<64-lowercase-hex-worker-secret>
POSTGRES_PASSWORD_FILE=<absolute-path-to-local-postgres-password-file>
PHASE0_API_BASE_URL=<server-side-api-origin>
